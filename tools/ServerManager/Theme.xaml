<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:views="clr-namespace:S2x.ServerManager.Views">

  <!--
    Tokens. ThemeManager replaces every value here when it starts (Services/ThemeResources.cs
    derives them from the theme pack); these are the Undead defaults, so a view built before
    that still has something sensible. Read them with DynamicResource: solid colours are
    recoloured in place, the rest are swapped under their keys.
  -->
  <SolidColorBrush x:Key="Accent"     Color="#FFE0313B"/>
  <SolidColorBrush x:Key="AccentHot"  Color="#FFE65A62"/>
  <SolidColorBrush x:Key="Ok"         Color="#FF86FF5C"/>
  <SolidColorBrush x:Key="Danger"     Color="#FFFF4436"/>
  <SolidColorBrush x:Key="Ink"        Color="#FFEADCD5"/>
  <SolidColorBrush x:Key="Label"      Color="#FFC9B2A8"/>
  <SolidColorBrush x:Key="Muted"      Color="#FFA08378"/>
  <SolidColorBrush x:Key="Dim"        Color="#FF8F766C"/>
  <SolidColorBrush x:Key="Faint"      Color="#FF7F6760"/>
  <SolidColorBrush x:Key="Ghost"      Color="#FF5C443D"/>
  <SolidColorBrush x:Key="StatusOff"  Color="#FF5D4A44"/>
  <SolidColorBrush x:Key="Line"       Color="#FF3D2621"/>
  <SolidColorBrush x:Key="Edge"       Color="#FF4A322C"/>
  <SolidColorBrush x:Key="EdgeHot"    Color="#FF6C5049"/>
  <SolidColorBrush x:Key="BtnEdge"    Color="#FF3D2621"/>
  <SolidColorBrush x:Key="IconEdge"   Color="#FF301E1A"/>
  <SolidColorBrush x:Key="Field"      Color="#FF211715"/>
  <SolidColorBrush x:Key="Row"        Color="#FF1E1513"/>
  <SolidColorBrush x:Key="Panel"      Color="#FF0F0B0A"/>
  <SolidColorBrush x:Key="Bar"        Color="#FF181110"/>
  <SolidColorBrush x:Key="Knob"       Color="#FFFFF2EE"/>
  <SolidColorBrush x:Key="TagBg"      Color="#FF311414"/>
  <SolidColorBrush x:Key="TagEdge"    Color="#FF76211F"/>
  <SolidColorBrush x:Key="DangerBg"   Color="#FF321614"/>
  <SolidColorBrush x:Key="DangerEdge" Color="#FF8C2B23"/>
  <SolidColorBrush x:Key="Divider"    Color="#FF3D2621"/>
  <SolidColorBrush x:Key="WindowEdge" Color="#FF4F3530"/>
  <SolidColorBrush x:Key="Surface"    Color="#FF211715"/>
  <SolidColorBrush x:Key="FillInk"    Color="#FFFFF2EE"/>
  <SolidColorBrush x:Key="OkTint"     Color="#2486FF5C"/>
  <SolidColorBrush x:Key="AccentTint" Color="#24E0313B"/>
  <SolidColorBrush x:Key="DangerTint" Color="#24FF4436"/>
  <SolidColorBrush x:Key="MutedTint"  Color="#24A08378"/>

  <!-- The fill: a solid colour or a gradient, on primary buttons, bars and the brand mark. -->
  <LinearGradientBrush x:Key="Fill" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#FFD91F2B" Offset="0"/>
    <GradientStop Color="#FF8E0C14" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="FillHot" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#FFFA2432" Offset="0"/>
    <GradientStop Color="#FFA30E17" Offset="1"/>
  </LinearGradientBrush>

  <!-- Effects: null when Textures & glow is off. -->
  <x:Null x:Key="Glow"/>
  <x:Null x:Key="OkGlow"/>
  <x:Null x:Key="TextGlow"/>
  <x:Null x:Key="CardShadow"/>

  <CornerRadius x:Key="Radius">3</CornerRadius>
  <sys:Double x:Key="RadiusValue">3</sys:Double>
  <CornerRadius x:Key="RadiusBadge">2</CornerRadius>
  <sys:Double x:Key="RadiusBadgeValue">2</sys:Double>
  <Thickness x:Key="BadgeBorder">1</Thickness>
  <Thickness x:Key="BadgeInner">2</Thickness>
  <Visibility x:Key="BadgeSolidVisibility">Visible</Visibility>
  <Visibility x:Key="BadgeDoubleVisibility">Collapsed</Visibility>
  <Visibility x:Key="BadgeDashedVisibility">Collapsed</Visibility>
  <x:Static x:Key="BadgeTransform" Member="Transform.Identity"/>

  <!-- Font roles and sizes (Services/ThemeFonts.cs picks the family, embedded or fallback). -->
  <FontFamily x:Key="FontDisplay">Impact, Segoe UI Symbol</FontFamily>
  <FontWeight x:Key="FontDisplayWeight">Normal</FontWeight>
  <FontStretch x:Key="FontDisplayStretch">Normal</FontStretch>
  <FontFamily x:Key="FontBody">Bahnschrift, Segoe UI, Segoe UI Symbol</FontFamily>
  <FontStretch x:Key="FontBodyStretch">SemiCondensed</FontStretch>
  <FontFamily x:Key="FontLabel">Bahnschrift, Segoe UI, Segoe UI Symbol</FontFamily>
  <FontWeight x:Key="FontLabelWeight">SemiBold</FontWeight>
  <FontStretch x:Key="FontLabelStretch">SemiCondensed</FontStretch>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Segoe UI Symbol</FontFamily>
  <sys:Double x:Key="SizeBody">13</sys:Double>
  <sys:Double x:Key="SizeBodyL">14</sys:Double>
  <sys:Double x:Key="SizeBodyS">12</sys:Double>
  <sys:Double x:Key="SizeBodyXS">11</sys:Double>
  <sys:Double x:Key="SizeHeading">16</sys:Double>
  <sys:Double x:Key="SizeLabel">10.5</sys:Double>
  <sys:Double x:Key="SizeLabelL">11</sys:Double>
  <sys:Double x:Key="SizeButton">11.5</sys:Double>
  <sys:Double x:Key="SizeMono">11</sys:Double>
  <sys:Double x:Key="SizeMonoS">10</sys:Double>
  <sys:Double x:Key="SizeMonoL">12.5</sys:Double>
  <sys:Double x:Key="SizePort">15</sys:Double>
  <sys:Double x:Key="SizeMonoXL">20</sys:Double>
  <sys:Double x:Key="SizeStat">26</sys:Double>
  <sys:Double x:Key="SizeBrand">17</sys:Double>
  <sys:Double x:Key="SizeTile">15</sys:Double>
  <sys:Double x:Key="SizeDisplay">24</sys:Double>
  <sys:Double x:Key="SizeDisplayL">32</sys:Double>

  <!-- ── windows ──────────────────────────────────────────────────────────── -->
  <!-- Every window: its content, then the theme's overlay (scanlines, vignette) on top. -->
  <Style x:Key="ThemedWindow" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Panel}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
    <Setter Property="FontStretch" Value="{DynamicResource FontBodyStretch}"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeBody}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Window">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <AdornerDecorator>
                <ContentPresenter/>
              </AdornerDecorator>
              <views:ThemeOverlay/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── text ─────────────────────────────────────────────────────────────── -->
  <Style x:Key="Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
    <Setter Property="FontStretch" Value="Normal"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeMono}"/>
    <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
  </Style>
  <!-- Small caps labels: the pack's label font. -->
  <Style x:Key="Caps" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontLabel}"/>
    <Setter Property="FontWeight" Value="{DynamicResource FontLabelWeight}"/>
    <Setter Property="FontStretch" Value="{DynamicResource FontLabelStretch}"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeLabel}"/>
    <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
  </Style>
  <Style x:Key="CapsL" TargetType="TextBlock" BasedOn="{StaticResource Caps}">
    <Setter Property="FontSize" Value="{DynamicResource SizeLabelL}"/>
  </Style>
  <Style x:Key="Stat" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
    <Setter Property="FontStretch" Value="Normal"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeStat}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Effect" Value="{DynamicResource TextGlow}"/>
  </Style>
  <!-- Headings: the pack's display font. -->
  <Style x:Key="Display" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontDisplay}"/>
    <Setter Property="FontWeight" Value="{DynamicResource FontDisplayWeight}"/>
    <Setter Property="FontStretch" Value="{DynamicResource FontDisplayStretch}"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeDisplay}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Effect" Value="{DynamicResource TextGlow}"/>
  </Style>

  <!-- The state dot. A server that is up but has not answered yet blinks. -->
  <Style x:Key="StateDot" TargetType="Rectangle">
    <Setter Property="Width" Value="7"/>
    <Setter Property="Height" Value="7"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsStarting}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="PulseDot">
            <Storyboard Timeline.DesiredFrameRate="20">
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3"
                               Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="PulseDot"/>
        </DataTrigger.ExitActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ── status badge ─────────────────────────────────────────────────────── -->
  <!-- The theme's badge: border width and style (solid, dashed, double), radius, transform
       (Field Ops tilts, Pack-a-Punch skews) and a tint of the status colour behind the text. -->
  <Style TargetType="views:StatusBadge">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Padding" Value="8,2,9,2"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontLabel}"/>
    <Setter Property="FontWeight" Value="{DynamicResource FontLabelWeight}"/>
    <Setter Property="FontStretch" Value="{DynamicResource FontLabelStretch}"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeLabelL}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="views:StatusBadge">
          <Grid RenderTransformOrigin="0.5,0.5" RenderTransform="{DynamicResource BadgeTransform}" SnapsToDevicePixels="False">
            <Grid x:Name="frame">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Foreground}"
                      BorderThickness="{DynamicResource BadgeBorder}" views:ThemeAssist.FitRadius="{DynamicResource RadiusBadgeValue}"
                      Visibility="{DynamicResource BadgeSolidVisibility}"/>
              <Border Margin="{DynamicResource BadgeInner}" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1"
                      views:ThemeAssist.FitRadius="{DynamicResource RadiusBadgeValue}" Visibility="{DynamicResource BadgeDoubleVisibility}"/>
              <Rectangle Fill="{TemplateBinding Background}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                         StrokeDashArray="3 2" views:ThemeAssist.FitRadius="{DynamicResource RadiusBadgeValue}"
                         Visibility="{DynamicResource BadgeDashedVisibility}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
              <Grid Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                <Rectangle x:Name="square" Fill="{TemplateBinding Foreground}"/>
                <Ellipse x:Name="dot" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
              <ContentPresenter VerticalAlignment="Center" Effect="{DynamicResource TextGlow}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Pulse" Value="True">
              <Setter TargetName="square" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="frame" Property="Effect" Value="{DynamicResource OkGlow}"/>
              <Trigger.EnterActions>
                <!-- The one animation in the app: a slow breath at a low frame rate. -->
                <BeginStoryboard x:Name="Breathe">
                  <Storyboard Timeline.DesiredFrameRate="24">
                    <DoubleAnimation Storyboard.TargetName="dot" Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.35" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever">
                      <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="1" To="0.7" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever">
                      <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="1" To="0.7" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever">
                      <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Breathe"/>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A small outlined tag: MP / ZM on a card, the gametype on a rotation line. -->
  <Style x:Key="Tag" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="views:ThemeAssist.FitRadius" Value="{DynamicResource RadiusBadgeValue}"/>
    <Setter Property="Padding" Value="7,1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="TagText" TargetType="TextBlock" BasedOn="{StaticResource Caps}">
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
  </Style>

  <!-- ── buttons ──────────────────────────────────────────────────────────── -->
  <Style x:Key="KeyboardFocus" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Grid IsHitTestVisible="False">
            <Rectangle Margin="2" Stroke="{DynamicResource Panel}" StrokeThickness="3"/>
            <Rectangle Margin="2" Stroke="{DynamicResource Ink}" StrokeThickness="1" StrokeDashArray="2,1"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- One template; Tag carries the hover background so the variants stay short. Buttons are
       set in the label font, as the pack sets them. -->
  <Style x:Key="Flat" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontLabel}"/>
    <Setter Property="FontWeight" Value="{DynamicResource FontLabelWeight}"/>
    <Setter Property="FontStretch" Value="{DynamicResource FontLabelStretch}"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeButton}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Tag" Value="{DynamicResource Row}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{Binding (views:ThemeAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                    SnapsToDevicePixels="True"/>
            <Rectangle x:Name="underline" Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
            <ContentPresenter x:Name="content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background"
                      Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Trigger>
            <Trigger Property="views:ThemeAssist.Active" Value="True">
              <Setter TargetName="underline" Property="Visibility" Value="Visible"/>
              <Setter TargetName="content" Property="Effect" Value="{DynamicResource TextGlow}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Caption" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontStretch" Value="Normal"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Tag" Value="{DynamicResource Field}"/>
  </Style>
  <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
    <Setter Property="Tag" Value="{DynamicResource Danger}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Knob}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- The filled button: the theme's fill (solid or gradient), its ink, and its glow. -->
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Foreground" Value="{DynamicResource FillInk}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="18,10"/>
    <Setter Property="views:ThemeAssist.CornerRadius" Value="{DynamicResource Radius}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bd" Background="{DynamicResource Fill}" Effect="{DynamicResource Glow}"
                    CornerRadius="{Binding (views:ThemeAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                    SnapsToDevicePixels="True"/>
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource FillHot}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
              <Setter Property="Cursor" Value="Arrow"/>
              <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Stop all, Stop, Delete: a quiet surface that turns the danger colour on hover. -->
  <Style x:Key="DangerGhost" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Tag" Value="{DynamicResource DangerBg}"/>
    <Setter Property="views:ThemeAssist.CornerRadius" Value="{DynamicResource Radius}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Outline" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Tag" Value="Transparent"/>
    <Setter Property="views:ThemeAssist.CornerRadius" Value="{DynamicResource Radius}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A segmented control's button. ThemeAssist.Active marks the chosen one: surface,
       accent text, a 2px accent underline and the theme's text glow. -->
  <Style x:Key="Segment" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Tag" Value="{DynamicResource Row}"/>
    <Style.Triggers>
      <Trigger Property="views:ThemeAssist.Active" Value="True">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Tag" Value="{DynamicResource Surface}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SegmentGroup" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}"/>
    <Setter Property="views:ThemeAssist.ClipRadius" Value="{DynamicResource RadiusValue}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- Card footer buttons -->
  <Style x:Key="CardAction" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Tag" Value="{DynamicResource Surface}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True"/>
          <Condition Property="IsEnabled" Value="True"/>
        </MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CardStart" TargetType="Button" BasedOn="{StaticResource Primary}">
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="views:ThemeAssist.CornerRadius" Value="0"/>
  </Style>

  <Style x:Key="CardStop" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Tag" Value="{DynamicResource DangerBg}"/>
  </Style>

  <Style x:Key="CardRestart" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Background" Value="{DynamicResource TagBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Tag" Value="{DynamicResource Accent}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Knob}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CardCopy" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
    <Setter Property="FontStretch" Value="Normal"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeMonoS}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Tag" Value="{DynamicResource Surface}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Starter" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Background" Value="{DynamicResource Bar}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontStretch" Value="{DynamicResource FontBodyStretch}"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeBody}"/>
    <Setter Property="Tag" Value="{DynamicResource Row}"/>
    <Setter Property="views:ThemeAssist.CornerRadius" Value="{DynamicResource Radius}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="RosterRow" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Tag" Value="{DynamicResource Row}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontStretch" Value="{DynamicResource FontBodyStretch}"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeBody}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Row}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── editor fields ────────────────────────────────────────────────────── -->
  <Style x:Key="Entry" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Field}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="views:ThemeAssist.CornerRadius" Value="{DynamicResource Radius}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"
                  CornerRadius="{Binding (views:ThemeAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource Entry}">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
    <Setter Property="FontStretch" Value="Normal"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeMonoL}"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="Padding" Value="6,4"/>
  </Style>

  <!-- The pack's switch: off is an empty track and a muted knob on the left; on is the
       surface with the fill's knob, glowing, on the right. -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="track" Background="Transparent" BorderBrush="{DynamicResource EdgeHot}"
                  BorderThickness="1" SnapsToDevicePixels="True" views:ThemeAssist.FitRadius="{DynamicResource RadiusBadgeValue}"
                  Padding="2">
            <Border x:Name="knob" Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                    Background="{DynamicResource Muted}" views:ThemeAssist.FitRadius="{DynamicResource RadiusBadgeValue}"
                    HorizontalAlignment="Left"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource Surface}"/>
              <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Line}"/>
              <Setter TargetName="knob" Property="Background" Value="{DynamicResource Fill}"/>
              <Setter TargetName="knob" Property="Effect" Value="{DynamicResource Glow}"/>
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SwitchLarge" TargetType="ToggleButton" BasedOn="{StaticResource Switch}">
    <Setter Property="Width" Value="48"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
  </Style>

  <!-- Map and mode pickers. The stock ComboBox brings its own light chrome. -->
  <Style x:Key="PickerItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    <Setter Property="Padding" Value="9,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Row}"/>
              <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Picker" TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource PickerItem}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="face" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}"
                          BorderThickness="1" SnapsToDevicePixels="True" CornerRadius="{DynamicResource Radius}">
                    <Path Data="M0,0 L8,0 L4,5 Z" Fill="{DynamicResource Muted}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource EdgeHot}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="9,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}">
              <!-- A narrow picker trims its choice instead of cutting it. -->
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False"
                   AllowsTransparency="True" PopupAnimation="None">
              <Border Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Bot fill. The pips above it carry the value; this is only the handle. -->
  <Style x:Key="FillSlider" TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Background="Transparent">
            <Rectangle Height="2" Fill="{DynamicResource Edge}" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track">
              <Track.Thumb>
                <Thumb Width="9" Height="16">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource Fill}" views:ThemeAssist.FitRadius="{DynamicResource RadiusBadgeValue}"
                              Effect="{DynamicResource Glow}"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Rotation rows: the list is the mockup's, selection is a bar down the left. -->
  <Style x:Key="RotationItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="marker" BorderBrush="Transparent" BorderThickness="2,0,0,0" Margin="0,0,0,2">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="marker" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RotationList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <!-- A ListBox brings the system's own text colour, which is black on this panel. -->
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource RotationItem}"/>
  </Style>

  <!-- The small square buttons at the end of a rotation row. -->
  <Style x:Key="RowIcon" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontStretch" Value="Normal"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource IconEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Margin" Value="3,0,0,0"/>
    <Setter Property="Tag" Value="Transparent"/>
    <Setter Property="views:ThemeAssist.CornerRadius" Value="{DynamicResource Radius}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EdgeHot}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="RowRemove" TargetType="Button" BasedOn="{StaticResource RowIcon}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource Flat}">
    <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontStretch" Value="{DynamicResource FontBodyStretch}"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeBodyXS}"/>
    <Setter Property="Padding" Value="2,4"/>
    <Setter Property="Tag" Value="Transparent"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ── scrollbar ────────────────────────────────────────────────────────── -->
  <ControlTemplate x:Key="HorizontalBar" TargetType="ScrollBar">
    <Grid Background="Transparent">
      <Track x:Name="PART_Track">
        <Track.Thumb>
          <Thumb>
            <Thumb.Template>
              <ControlTemplate TargetType="Thumb">
                <Border Background="{DynamicResource EdgeHot}" views:ThemeAssist.FitRadius="{DynamicResource RadiusBadgeValue}"/>
              </ControlTemplate>
            </Thumb.Template>
          </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
        </Track.IncreaseRepeatButton>
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
        </Track.DecreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource EdgeHot}" views:ThemeAssist.FitRadius="{DynamicResource RadiusBadgeValue}"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- The console scrolls sideways too; a horizontal bar needs its own track. -->
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template" Value="{StaticResource HorizontalBar}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Right-click menus. Only the copy button has one: the connect line off this machine. -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Field}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Padding" Value="0,4"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeMono}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="chrome" Background="Transparent" Padding="14,6">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="chrome" Property="Background" Value="{DynamicResource Row}"/>
              <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tooltips follow the theme instead of the system's pale yellow. -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Field}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
    <Setter Property="FontSize" Value="{DynamicResource SizeBodyS}"/>
  </Style>

</ResourceDictionary>
