<Window x:Class="S2x.ServerManager.Views.SettingsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Server Manager settings" Width="460" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Panel}"
 Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
 <StackPanel Margin="24">
  <TextBlock Text="Appearance" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <TextBlock Text="Choose a theme. Changes apply immediately and are remembered on this computer."
   Foreground="{DynamicResource Label}" TextWrapping="Wrap" Margin="0,0,0,18"/>
  <TextBlock Text="Theme" Margin="0,0,0,6"/>
  <ComboBox x:Name="theme" Style="{StaticResource Picker}" AutomationProperties.Name="Theme">
   <ComboBoxItem Content="Classic — dark amber" Tag="Classic"/>
   <ComboBoxItem Content="Light" Tag="Light"/>
   <ComboBoxItem Content="High contrast — dark" Tag="HighContrast"/>
  </ComboBox>
  <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" Padding="14" Margin="0,18,0,0">
   <StackPanel>
    <TextBlock Text="Server preview" Foreground="{DynamicResource Ink}" FontWeight="SemiBold"/>
    <TextBlock Text="Running · 4 players" Foreground="{DynamicResource Ok}" Margin="0,6,0,0"/>
    <TextBlock Text="Attention: an update is available" Foreground="{DynamicResource Danger}" Margin="0,6,0,0"/>
   </StackPanel>
  </Border>
  <TextBlock x:Name="message" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,12,0,0"/>
  <Button x:Name="done" Content="Done" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0,18,0,0" IsCancel="True" MinWidth="88"/>
 </StackPanel>
</Window>
