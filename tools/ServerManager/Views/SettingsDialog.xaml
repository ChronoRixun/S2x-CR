<Window x:Class="S2x.ServerManager.Views.SettingsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:S2x.ServerManager.Views"
 Title="Server Manager settings" Width="600" SizeToContent="Height" ResizeMode="NoResize"
 WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Style="{StaticResource ThemedWindow}" BorderBrush="{DynamicResource WindowEdge}" BorderThickness="1"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <!-- One theme, drawn in its own colours, fonts and texture whatever the app is showing. -->
  <DataTemplate x:Key="TileTemplate">
   <Button Margin="0,0,8,8" Click="PickTile" Cursor="Hand" FocusVisualStyle="{StaticResource KeyboardFocus}"
           AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Tagline}">
    <Button.Template>
     <ControlTemplate TargetType="Button">
      <Grid Background="Transparent">
       <!-- the selected ring: 2px of the theme's accent, 2px outside the tile -->
       <Border BorderBrush="{Binding Accent}" BorderThickness="2" CornerRadius="{Binding RingRadius}"
               Visibility="{Binding RingVisibility}"/>
       <Grid Margin="4" Height="80">
        <views:ThemeBackdrop Theme="{Binding Mode}" views:ThemeAssist.ClipRadius="{Binding RadiusValue}"/>
        <Border BorderBrush="{Binding Line}" BorderThickness="1" CornerRadius="{Binding Radius}"/>
        <Border x:Name="hover" Background="#18FFFFFF" CornerRadius="{Binding Radius}" Visibility="Collapsed"/>
        <StackPanel VerticalAlignment="Bottom" Margin="11,0,10,10">
         <StackPanel Orientation="Horizontal">
          <Border Width="44" Height="6" Background="{Binding Fill}" Effect="{Binding Glow}"/>
          <Rectangle Width="6" Height="6" Fill="{Binding Ok}" Margin="4,0,0,0"/>
          <Rectangle Width="6" Height="6" Fill="{Binding Bad}" Margin="4,0,0,0"/>
         </StackPanel>
         <TextBlock Text="{Binding Name}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                    FontFamily="{Binding DisplayFont}" FontWeight="{Binding DisplayWeight}" FontStretch="{Binding DisplayStretch}"
                    FontSize="{Binding NameSize}" Foreground="{Binding Accent}" Effect="{Binding TextGlow}"/>
        </StackPanel>
       </Grid>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="hover" Property="Visibility" Value="Visible"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Button.Template>
   </Button>
  </DataTemplate>
 </Window.Resources>

 <StackPanel>
  <Border x:Name="barTitle" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}"
          BorderThickness="0,0,0,1" Height="40">
   <DockPanel>
    <Polygon DockPanel.Dock="Left" Points="0,0 12,0 12,12" Fill="{DynamicResource Fill}" Margin="14,0,10,0"
             VerticalAlignment="Center"/>
    <Button DockPanel.Dock="Right" x:Name="btnClose" Style="{StaticResource CaptionClose}" Content="&#x2715;"
            ToolTip="Close"/>
    <TextBlock Text="Server Manager settings" FontSize="{DynamicResource SizeBodyS}" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>

  <StackPanel Margin="28,24,28,26">
   <TextBlock Text="Appearance" Style="{StaticResource Display}" FontSize="{DynamicResource SizeDisplayL}"/>
   <TextBlock Text="Pick a loadout. Applies instantly and is remembered for this Windows user."
              Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,18"/>

   <ItemsControl x:Name="tiles" ItemTemplate="{StaticResource TileTemplate}" Margin="0,0,-8,0"
                 KeyboardNavigation.TabNavigation="Continue">
    <ItemsControl.ItemsPanel>
     <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
   </ItemsControl>

   <Border Margin="0,10,0,0" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}"
           BorderThickness="1" CornerRadius="{DynamicResource Radius}">
    <StackPanel>
     <DockPanel Margin="16,14">
      <ToggleButton x:Name="effects" DockPanel.Dock="Right" Style="{StaticResource SwitchLarge}" VerticalAlignment="Center"
                    AutomationProperties.Name="Textures and glow" ToolTip="Turn textures, overlays and glow on or off"/>
      <StackPanel Margin="0,0,16,0">
       <TextBlock Text="Textures &amp; glow" Foreground="{DynamicResource Ink}"/>
       <TextBlock x:Name="effectsNote" Text="Scanlines, grain and neon. Off = flat colors." FontSize="{DynamicResource SizeBodyS}"
                  Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </DockPanel>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,14">
      <StackPanel>
       <TextBlock views:TextEffects.Tracked="PREVIEW" Style="{StaticResource Caps}" Foreground="{DynamicResource Muted}"/>
       <WrapPanel Margin="0,10,0,0">
        <views:StatusBadge Foreground="{DynamicResource Ok}" Background="{DynamicResource OkTint}" Pulse="True" Margin="0,0,10,4">
         <TextBlock views:TextEffects.Tracked="RUNNING &#xB7; 14 PLAYERS"/>
        </views:StatusBadge>
        <views:StatusBadge Foreground="{DynamicResource Danger}" Background="{DynamicResource DangerTint}" Margin="0,0,10,4">
         <TextBlock views:TextEffects.Tracked="ATTENTION"/>
        </views:StatusBadge>
       </WrapPanel>
      </StackPanel>
     </Border>
    </StackPanel>
   </Border>

   <TextBlock x:Name="message" Foreground="{DynamicResource Danger}" FontSize="{DynamicResource SizeBodyS}"
              TextWrapping="Wrap" Margin="0,12,0,0">
    <TextBlock.Style>
     <Style TargetType="TextBlock">
      <Style.Triggers>
       <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
   <Button x:Name="done" Content="DONE" Style="{StaticResource Primary}" HorizontalAlignment="Right"
           Height="44" Padding="34,0" Margin="0,18,0,0" IsCancel="True" MinWidth="110"/>
  </StackPanel>
 </StackPanel>
</Window>
