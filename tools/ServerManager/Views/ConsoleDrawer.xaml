<UserControl x:Class="S2x.ServerManager.Views.ConsoleDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:S2x.ServerManager.Views"
             FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}">

  <UserControl.Resources>
    <!-- The grip along the top edge: drag the drawer taller or shorter. -->
    <Style x:Key="Grip" TargetType="Thumb">
      <Setter Property="Height" Value="5"/>
      <Setter Property="Cursor" Value="SizeNS"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="Transparent">
              <Rectangle Height="1" Fill="{StaticResource Edge}" VerticalAlignment="Center"
                         Margin="0" Opacity="0"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DrawerButton" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="BorderBrush" Value="{StaticResource BtnEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Tag" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource Accent}"/>
          <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="LogLineTemplate">
      <TextBlock Text="{Binding Text}" Foreground="{Binding Fill}" FontFamily="Consolas"
                 FontSize="11.5" LineHeight="19" TextWrapping="NoWrap"/>
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="{StaticResource Bar}" BorderBrush="{StaticResource TagEdge}" BorderThickness="0,1,0,0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="5"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Thumb x:Name="grip" Grid.Row="0" Style="{StaticResource Grip}"/>

      <!-- header: which server, which file, and what the drawer is doing -->
      <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <DockPanel Margin="20,0,12,0" LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" views:TextEffects.Tracked="CONSOLE" FontSize="10.5"
                     FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
          <Rectangle DockPanel.Dock="Left" Width="7" Height="7" Fill="{Binding DotBrush}"
                     VerticalAlignment="Center" Margin="10,0,0,0"/>
          <TextBlock DockPanel.Dock="Left" views:TextEffects.ColorName="{Binding ServerName}"
                     FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                     MaxWidth="240" TextTrimming="CharacterEllipsis"/>

          <Button DockPanel.Dock="Right" Style="{StaticResource DrawerButton}" Width="26" Padding="0"
                  Content="&#x2715;" FontWeight="Normal" Foreground="{StaticResource Dim}"
                  Command="{Binding CloseCommand}" ToolTip="Close the console (Esc)"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource DrawerButton}" Content="COPY"
                  Command="{Binding CopyCommand}" ToolTip="Copy the lines on screen"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource DrawerButton}" Content="FOLLOW"
                  Command="{Binding FollowCommand}" Background="{Binding FollowBackground}"
                  Foreground="{Binding FollowForeground}" ToolTip="Scroll to the newest line"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource DrawerButton}" Content="{Binding PauseLabel}"
                  Command="{Binding PauseCommand}" Background="{Binding PauseBackground}"
                  Foreground="{Binding PauseForeground}" ToolTip="Hold the lines where they are"/>
          <Grid DockPanel.Dock="Right" Width="190" Height="26" Margin="6,0,0,0" VerticalAlignment="Center">
            <TextBox x:Name="txtFilter" Style="{StaticResource Entry}" FontSize="12" Padding="8,3"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="filter" IsHitTestVisible="False" FontSize="12" Foreground="{StaticResource Faint}"
                       Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                       Visibility="{Binding FilterPlaceholderVisibility}"/>
          </Grid>

          <!-- whether this is the server's own log, and the file being read -->
          <Border DockPanel.Dock="Left" Visibility="{Binding SharedVisibility}" Margin="14,0,0,0"
                  Background="{StaticResource TagBg}" BorderBrush="{StaticResource TagEdge}"
                  BorderThickness="1" Padding="7,2" VerticalAlignment="Center">
            <TextBlock Text="{Binding SharedNote}" FontSize="11" Foreground="{StaticResource Accent}"/>
          </Border>
          <TextBlock DockPanel.Dock="Left" Text="{Binding LogFile}" Style="{StaticResource Mono}"
                     VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>

      <ScrollViewer x:Name="scroll" Grid.Row="2" Padding="20,8" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource LogLineTemplate}"/>
          <TextBlock Text="{Binding HeldNote}" Visibility="{Binding HeldVisibility}"
                     Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="11.5"
                     Margin="0,6,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
