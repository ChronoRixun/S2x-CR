<Window x:Class="S2x.ServerManager.Views.NewServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:S2x.ServerManager.Views"
        Title="S2x Server Manager" Width="520" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ThemedWindow}"
        BorderBrush="{DynamicResource WindowEdge}" BorderThickness="1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <DataTemplate x:Key="ChoiceTemplate">
      <Button Style="{StaticResource Starter}" Margin="0,0,0,8" Click="ChoicePicked"
              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <DockPanel Margin="14,12">
          <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" Style="{StaticResource Mono}"
                     VerticalAlignment="Center" Margin="12,0,0,0"/>
          <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource SizeBodyL}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
            <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource SizeBodyXS}" Foreground="{DynamicResource Muted}"
                       Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <StackPanel>
    <Border x:Name="barTitle" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,0,0,1" Padding="16,0" Height="36">
      <TextBlock views:TextEffects.Tracked="NEW SERVER" Style="{StaticResource CapsL}"
                 Foreground="{DynamicResource Accent}" Effect="{DynamicResource TextGlow}" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Margin="20,16,20,18">
      <TextBlock Text="Start from one of the bundled rotations, or from nothing."
                 FontSize="{DynamicResource SizeBodyS}" Foreground="{DynamicResource Label}" Margin="0,0,0,12"/>
      <ItemsControl x:Name="lstChoices" ItemTemplate="{StaticResource ChoiceTemplate}"/>
      <!-- CANCEL first, so it keeps its width; the note wraps into what is left. -->
      <DockPanel Margin="0,8,0,0">
        <Button DockPanel.Dock="Right" x:Name="btnCancel" Style="{StaticResource Outline}" Content="CANCEL"
                IsCancel="True" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBlock Text="It opens in the editor on the next free port. Nothing is written until you save."
                   FontSize="{DynamicResource SizeBodyXS}" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
      </DockPanel>
    </StackPanel>
  </StackPanel>
</Window>
