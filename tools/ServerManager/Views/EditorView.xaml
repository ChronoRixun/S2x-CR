<UserControl x:Class="S2x.ServerManager.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:S2x.ServerManager.Views"
             FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Ink}"
             Background="{StaticResource Panel}">

  <UserControl.Resources>

    <!-- ^0-^7, dropped in at the caret -->
    <DataTemplate x:Key="SwatchTemplate">
      <Button Style="{StaticResource Swatch}" Background="{Binding Fill}" BorderBrush="{Binding Stroke}"
              Command="{Binding InsertCommand}" ToolTip="{Binding Tip}"/>
    </DataTemplate>

    <DataTemplate x:Key="SegmentTemplate">
      <Button Style="{StaticResource Flat}" Content="{Binding Label}" Command="{Binding PickCommand}"
              Background="{Binding Background}" Foreground="{Binding Foreground}"
              BorderBrush="{StaticResource Edge}" BorderThickness="1,0,0,0"
              FontSize="10.5" Padding="10,0"/>
    </DataTemplate>

    <DataTemplate x:Key="PipTemplate">
      <Rectangle Height="6" Fill="{Binding Fill}" Stroke="{Binding Stroke}" StrokeThickness="1" Margin="0,0,2,0"/>
    </DataTemplate>

    <!-- one score limit box per mode in the rotation -->
    <DataTemplate x:Key="ScoreRowTemplate">
      <StackPanel Margin="0,0,14,8">
        <DockPanel>
          <TextBox DockPanel.Dock="Right" Width="52" Style="{StaticResource Number}"
                   Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Label}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
        </DockPanel>
        <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="{StaticResource Line}"
              StrokeThickness="1" StrokeDashArray="1 2" Margin="0,6,0,0"/>
      </StackPanel>
    </DataTemplate>

    <!-- ── one rotation line ─────────────────────────────────────────────── -->
    <DataTemplate x:Key="RotationRowTemplate">
      <Border Background="{Binding Background}" BorderBrush="{Binding Edge}" BorderThickness="1"
              Opacity="{Binding Opacity}" Padding="0,8,10,8" views:DragReorder.Enabled="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="42"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="&#x22EE;&#x22EE;" Foreground="{StaticResource EdgeHot}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="SizeAll"
                     ToolTip="Drag to reorder"/>

          <Border Grid.Column="1" Width="26" Height="22" Background="{Binding NumberBackground}"
                  BorderBrush="{Binding NumberEdge}" BorderThickness="1" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Number}" FontFamily="Consolas" FontSize="11"
                       Foreground="{Binding NumberForeground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding MapName}" FontSize="13.5" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"/>
              <Border Visibility="{Binding PackVisibility}" BorderBrush="{StaticResource Edge}"
                      BorderThickness="1" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock views:TextEffects.Tracked="{Binding Pack}" FontSize="9.5" FontWeight="Bold"
                           Foreground="{StaticResource Muted}"/>
              </Border>
              <TextBlock views:TextEffects.Tracked="&#x25B6; NOW" Visibility="{Binding NowVisibility}"
                         FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Ok}"
                         Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding Line}" Style="{StaticResource Mono}" Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <Border Grid.Column="3" Background="{StaticResource TagBg}" BorderBrush="{StaticResource TagEdge}"
                  BorderThickness="1" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
            <TextBlock views:TextEffects.Tracked="{Binding GametypeCaps}" FontSize="10.5" FontWeight="Bold"
                       Foreground="{StaticResource Accent}"/>
          </Border>

          <TextBlock Grid.Column="4" Text="{Binding Limit}" Style="{StaticResource Mono}" Width="48"
                     TextAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>

          <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource RowIcon}" Content="&#x2912;" Command="{Binding TopCommand}"
                    ToolTip="Move to top" Margin="0"/>
            <Button Style="{StaticResource RowIcon}" Content="&#x25B2;" FontSize="9" Command="{Binding UpCommand}"
                    ToolTip="Move up"/>
            <Button Style="{StaticResource RowIcon}" Content="&#x25BC;" FontSize="9" Command="{Binding DownCommand}"
                    ToolTip="Move down"/>
            <Button Style="{StaticResource RowRemove}" Content="&#x2715;" Command="{Binding RemoveCommand}"
                    ToolTip="Remove"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="70"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="392"/>
      </Grid.ColumnDefinitions>

      <!-- ── left: name, mode, port, rotation ─────────────────────────────── -->
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}"
                  BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock views:TextEffects.Tracked="01 &#xB7; SERVER NAME" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                  <DockPanel>
                    <Rectangle DockPanel.Dock="Left" Width="3" Fill="{StaticResource Accent}"/>
                    <TextBox x:Name="txtName" Style="{StaticResource Entry}" BorderThickness="0"
                             Background="Transparent" FontSize="14" Padding="10,8"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                  </DockPanel>
                </Border>
                <DockPanel Margin="0,8,0,0">
                  <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Swatches}"
                                ItemTemplate="{StaticResource SwatchTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <TextBlock DockPanel.Dock="Left" views:TextEffects.Tracked="IN BROWSER" FontSize="9.5"
                             FontWeight="Bold" Foreground="{StaticResource Faint}"
                             Margin="8,0,10,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Value="True"
                                       Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=views:EditorView}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                          BorderThickness="1" Padding="8,2">
                    <TextBlock views:TextEffects.ColorName="{Binding Name}" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                  </Border>
                </DockPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="0,0,14,0">
                <TextBlock views:TextEffects.Tracked="MODE" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
                <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" Height="36">
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Flat}" Content="MULTIPLAYER" Padding="14,0"
                            Command="{Binding SetMultiplayerCommand}"
                            Background="{Binding MpBackground}" Foreground="{Binding MpForeground}"/>
                    <Button Style="{StaticResource Flat}" Content="ZOMBIES" Padding="14,0"
                            Command="{Binding SetZombiesCommand}"
                            Background="{Binding ZmBackground}" Foreground="{Binding ZmForeground}"
                            BorderBrush="{StaticResource Edge}" BorderThickness="1,0,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock views:TextEffects.Tracked="UDP PORT" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
                <TextBox Width="92" Height="36" Style="{StaticResource Number}" FontSize="14"
                         Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding PortWarning}" Visibility="{Binding PortWarningVisibility}"
                           FontSize="10.5" Foreground="{StaticResource Accent}" Margin="0,5,0,0"
                           MaxWidth="150" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,12">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ShuffleOnLaunch, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                <TextBlock FontSize="11.5" Foreground="{StaticResource Label}"
                           Margin="8,0,14,0" VerticalAlignment="Center" ToolTip="Shuffle on every launch">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="Shuffle on every launch"/>
                      <Style.Triggers>
                        <DataTrigger Value="True"
                                     Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=views:EditorView}}">
                          <Setter Property="Text" Value="Shuffle"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <Button Style="{StaticResource Outline}" Content="&#x2928; RANDOMIZE" FontSize="11"
                        FontWeight="SemiBold" Padding="12,6" Command="{Binding RandomizeCommand}"/>
                <Button Style="{StaticResource Link}" Content="Clear all" Margin="14,0,0,0"
                        Command="{Binding ClearCommand}"/>
              </StackPanel>
              <!-- The meta line is last so it takes what is left and trims, instead of growing
                   under the controls on the right. -->
              <DockPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock DockPanel.Dock="Left" views:TextEffects.Tracked="{Binding RotationTitle, StringFormat=02 &#xB7; {0}}"
                           FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Dim}"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding RotationCount}" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource Accent}" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding RotationMeta}" Style="{StaticResource Mono}" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="96"/>
              </Grid.ColumnDefinitions>
              <ComboBox Grid.Column="0" Style="{StaticResource Picker}" Margin="0,0,8,0"
                        ItemsSource="{Binding MapOptions}" SelectedItem="{Binding PickedMap, Mode=TwoWay}"
                        DisplayMemberPath="Label"/>
              <ComboBox Grid.Column="1" Style="{StaticResource Picker}" Margin="0,0,8,0"
                        ItemsSource="{Binding GametypeOptions}" SelectedItem="{Binding PickedGametype, Mode=TwoWay}"
                        DisplayMemberPath="Label"/>
              <Button Grid.Column="2" Style="{StaticResource Primary}" Content="+ ADD" Height="36"
                      Command="{Binding AddCommand}"/>
            </Grid>

            <Grid Grid.Row="2">
              <Rectangle Width="1" Fill="{StaticResource Line}" HorizontalAlignment="Left" Margin="47,0,0,0"/>
              <!-- A drop a row did not take is a drop into the space under the list: the end. -->
              <ListBox x:Name="lstRotation" Style="{StaticResource RotationList}"
                       views:DragReorder.EndZone="True"
                       ItemsSource="{Binding Rotation}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                       ItemTemplate="{StaticResource RotationRowTemplate}"/>
              <Grid Visibility="{Binding EmptyRotationVisibility}" VerticalAlignment="Top" Height="86">
                <Rectangle Fill="{StaticResource Panel}" Stroke="{StaticResource Edge}" StrokeThickness="1"
                           StrokeDashArray="3 3"/>
                <TextBlock Text="Empty rotation. Pick a map and a mode above, then Add." FontSize="12.5"
                           Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <!-- ── right: rules, bots, lobby, visibility, advanced ──────────────── -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>

          <StackPanel Visibility="{Binding MultiplayerVisibility}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
              <StackPanel>
                <DockPanel Margin="20,14,20,10">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreSummary}" Style="{StaticResource Mono}"/>
                  <TextBlock views:TextEffects.Tracked="03 &#xB7; MATCH RULES" FontSize="10" FontWeight="SemiBold"
                             Foreground="{StaticResource Dim}"/>
                </DockPanel>
                <StackPanel Margin="20,0,20,16">
                  <TextBlock Text="Score limits for the modes in this rotation." FontSize="11"
                             Foreground="{StaticResource Dim}" Margin="0,0,0,10"/>
                  <ItemsControl ItemsSource="{Binding ScoreRows}" ItemTemplate="{StaticResource ScoreRowTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding DomVisibility}">
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SingleRoundDom, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="Single-round Domination (no halftime)" FontSize="12"
                               Foreground="{StaticResource Label}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
              <StackPanel>
                <DockPanel Margin="20,14,20,10">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding BotSummary}" Style="{StaticResource Mono}"/>
                  <TextBlock views:TextEffects.Tracked="04 &#xB7; BOTS" FontSize="10" FontWeight="SemiBold"
                             Foreground="{StaticResource Dim}"/>
                </DockPanel>
                <StackPanel Margin="20,0,20,16">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding BotFill}" FontFamily="Consolas"
                               FontSize="20" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="Bot fill" FontSize="12" Foreground="{StaticResource Label}"
                               VerticalAlignment="Bottom"/>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding BotPips}" ItemTemplate="{StaticResource PipTemplate}"
                                Margin="0,8,-2,6">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <Slider Style="{StaticResource FillSlider}" Minimum="0" Maximum="{Binding Cap}"
                          Value="{Binding BotFill, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                  <DockPanel Margin="0,2,0,14">
                    <TextBlock DockPanel.Dock="Left" Text="0" Style="{StaticResource Mono}" FontSize="10.5"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Cap}" Style="{StaticResource Mono}" FontSize="10.5"/>
                    <TextBlock Text="bots leave as humans join" Style="{StaticResource Mono}" FontSize="10.5"
                               HorizontalAlignment="Center"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,10">
                    <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Edge}" BorderThickness="1" Height="28">
                      <ItemsControl ItemsSource="{Binding PoolOptions}" ItemTemplate="{StaticResource SegmentTemplate}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </Border>
                    <TextBlock Text="Name pool" FontSize="12" Foreground="{StaticResource Label}"
                               VerticalAlignment="Center"/>
                  </DockPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Edge}" BorderThickness="1" Height="28">
                      <ItemsControl ItemsSource="{Binding DifficultyOptions}" ItemTemplate="{StaticResource SegmentTemplate}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </Border>
                    <TextBlock Text="Difficulty" FontSize="12" Foreground="{StaticResource Label}"
                               VerticalAlignment="Center"/>
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <StackPanel>
              <DockPanel Margin="20,14,20,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding LobbySummary}" Style="{StaticResource Mono}"/>
                <TextBlock views:TextEffects.Tracked="{Binding LobbyNumber, StringFormat={}{0} &#xB7; LOBBY}"
                           FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Dim}"/>
              </DockPanel>
              <StackPanel Margin="20,0,20,16">
                <DockPanel>
                  <TextBox DockPanel.Dock="Right" Width="52" Style="{StaticResource Number}"
                           Text="{Binding CapText, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock FontSize="12" Foreground="{StaticResource Label}" VerticalAlignment="Center">
                    <Run Text="Player cap "/><Run Text="{Binding CapRange, Mode=OneWay}" Foreground="{StaticResource Faint}"/>
                  </TextBlock>
                </DockPanel>
                <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="{StaticResource Line}"
                      StrokeThickness="1" StrokeDashArray="1 2" Margin="0,6,0,8"/>
                <DockPanel>
                  <TextBox DockPanel.Dock="Right" Width="52" Style="{StaticResource Number}"
                           Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Minimum players to start" FontSize="12" Foreground="{StaticResource Label}"
                             VerticalAlignment="Center"/>
                </DockPanel>
                <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="{StaticResource Line}"
                      StrokeThickness="1" StrokeDashArray="1 2" Margin="0,6,0,8"/>
                <DockPanel>
                  <TextBox DockPanel.Dock="Right" Width="52" Style="{StaticResource Number}"
                           Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock FontSize="12" Foreground="{StaticResource Label}" VerticalAlignment="Center">
                    <Run Text="Countdown "/><Run Text="0-120 s" Foreground="{StaticResource Faint}"/>
                  </TextBlock>
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <StackPanel>
              <DockPanel Margin="20,14,20,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding VisibilitySummary}" FontFamily="Consolas"
                           FontSize="11" Foreground="{Binding VisibilityBrush}"/>
                <TextBlock views:TextEffects.Tracked="{Binding VisibilityNumber, StringFormat={}{0} &#xB7; VISIBILITY}"
                           FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Dim}"/>
              </DockPanel>
              <StackPanel Margin="20,0,20,16">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Advertise, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                  <TextBlock Text="Advertise on the master list" FontSize="12" Foreground="{StaticResource Label}"
                             Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding VisibilityNote}" FontSize="11" Foreground="{StaticResource Dim}"
                           TextWrapping="Wrap" LineHeight="16" Margin="40,8,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <StackPanel>
              <DockPanel Margin="20,14,20,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding AdvancedSummary}" Style="{StaticResource Mono}"/>
                <TextBlock views:TextEffects.Tracked="{Binding AdvancedNumber, StringFormat={}{0} &#xB7; ADVANCED}"
                           FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Dim}"/>
              </DockPanel>
              <StackPanel Margin="20,0,20,16">
                <Grid>
                  <TextBox Style="{StaticResource Entry}" Height="80" AcceptsReturn="True"
                           Background="{StaticResource Bar}" FontFamily="Consolas" FontSize="12"
                           VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"
                           Text="{Binding ExtraText, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="one dvar per line, e.g.  set g_speed 190" IsHitTestVisible="False"
                             Visibility="{Binding ExtraPlaceholderVisibility}" FontFamily="Consolas" FontSize="12"
                             Foreground="{StaticResource Faint}" Margin="10,9,0,0"
                             HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBlock Text="!" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Danger}"
                             Margin="0,0,6,0"/>
                  <TextBlock Text="Passed through as written. Nothing here is checked." FontSize="11"
                             Foreground="{StaticResource Danger}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Margin="20,16,20,16">
            <TextBlock views:TextEffects.Tracked="WRITES TO" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource Dim}" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding CfgPath}" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ── footer ────────────────────────────────────────────────────────── -->
    <Border Grid.Row="1" Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0">
      <DockPanel Margin="20,0" LastChildFill="False">
        <Rectangle DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding DotBrush}"
                   VerticalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock views:TextEffects.Tracked="{Binding StateCaps}" FontSize="10.5" FontWeight="Bold"
                     Foreground="{Binding StateBrush}"/>
          <TextBlock Text="{Binding StatusSub}" Style="{StaticResource Mono}" Margin="0,3,0,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Left" Visibility="{Binding DirtyVisibility}" Margin="14,0,0,0"
                Background="{StaticResource TagBg}" BorderBrush="{StaticResource TagEdge}" BorderThickness="1"
                Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="&#x25CF; UNSAVED" FontSize="11" Foreground="{StaticResource Accent}"/>
        </Border>
        <!-- Somebody else wrote this preset while it was open here. -->
        <Border DockPanel.Dock="Left" Visibility="{Binding FileChangedVisibility}" Margin="8,0,0,0"
                Background="{StaticResource DangerBg}" BorderBrush="{StaticResource DangerEdge}" BorderThickness="1"
                Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="FILE CHANGED ON DISK" FontSize="11" Foreground="{StaticResource Danger}"/>
        </Border>

        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="&#x25B6; LAUNCH SERVER"
                Padding="24,12" Visibility="{Binding LaunchVisibility}" Command="{Binding LaunchCommand}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="&#x21BB; RESTART"
                Padding="24,12" Visibility="{Binding RunningVisibility}" Command="{Binding RestartCommand}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource DangerGhost}" Content="&#x25A0; STOP"
                Padding="18,11" Margin="0,0,8,0" Visibility="{Binding RunningVisibility}"
                Command="{Binding StopCommand}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource Outline}" Content="SAVE AS&#x2026;"
                FontSize="11" FontWeight="SemiBold" Padding="14,9" Margin="0,0,14,0"
                Command="{Binding SaveAsCommand}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource Outline}" Content="SAVE PRESET"
                FontSize="11" FontWeight="SemiBold" Padding="14,9" Margin="0,0,8,0"
                ToolTip="Ctrl+S" Command="{Binding SaveCommand}"/>
      </DockPanel>
    </Border>

    <!-- the fleet's toast, over the editor too -->
    <Border Grid.RowSpan="2" Visibility="{Binding Fleet.ToastVisibility}" Background="{StaticResource Field}"
            BorderBrush="{StaticResource EdgeHot}" BorderThickness="1" Padding="14,8"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,90">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#x2713;" Foreground="{StaticResource Ok}" Margin="0,0,10,0"/>
        <TextBlock Text="{Binding Fleet.ToastText}" FontSize="12"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
