<UserControl x:Class="S2x.ServerManager.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:S2x.ServerManager.Views"
             Foreground="{DynamicResource Ink}"
             Background="{DynamicResource Panel}">

  <UserControl.Resources>

    <!-- ^0-^7, dropped in at the caret -->
    <DataTemplate x:Key="SwatchTemplate">
      <Button Style="{StaticResource Swatch}" Background="{Binding Fill}" BorderBrush="{Binding Stroke}"
              Command="{Binding InsertCommand}" ToolTip="{Binding Tip}"/>
    </DataTemplate>

    <DataTemplate x:Key="SegmentTemplate">
      <Button Style="{StaticResource Segment}" Content="{Binding Label}" Command="{Binding PickCommand}"
              views:ThemeAssist.Active="{Binding IsOn}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0"
              FontSize="{DynamicResource SizeLabelL}" Padding="10,0"/>
    </DataTemplate>

    <!-- A group a launch profile takes over: still on screen, visibly not in use. -->
    <Style x:Key="Greyed" TargetType="StackPanel">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A numbered section title: 03 · MATCH RULES. -->
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Caps}">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>

    <DataTemplate x:Key="PipTemplate">
      <Rectangle Height="6" Fill="{Binding Fill}" Stroke="{Binding Stroke}" StrokeThickness="1" Margin="0,0,2,0"/>
    </DataTemplate>

    <!-- one score limit box per mode in the rotation -->
    <DataTemplate x:Key="ScoreRowTemplate">
      <StackPanel Margin="0,0,14,8">
        <DockPanel>
          <TextBox DockPanel.Dock="Right" Width="52" Style="{StaticResource Number}"
                   Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding Label}" FontSize="{DynamicResource SizeBodyS}" Foreground="{DynamicResource Label}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
        </DockPanel>
        <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="{DynamicResource Line}"
              StrokeThickness="1" StrokeDashArray="1 2" Margin="0,6,0,0"/>
      </StackPanel>
    </DataTemplate>

    <!-- ── one rotation line ─────────────────────────────────────────────── -->
    <DataTemplate x:Key="RotationRowTemplate">
      <Border Background="{Binding Background}" BorderBrush="{Binding Edge}" BorderThickness="1"
              CornerRadius="{DynamicResource Radius}"
              Opacity="{Binding Opacity}" Padding="0,8,10,8" views:DragReorder.Enabled="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="42"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="&#x22EE;&#x22EE;" Foreground="{DynamicResource EdgeHot}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="SizeAll"
                     ToolTip="Drag to reorder"/>

          <Border Grid.Column="1" Width="28" Height="22" Background="{Binding NumberBackground}"
                  BorderBrush="{Binding NumberEdge}" BorderThickness="1" HorizontalAlignment="Center"
                  views:ThemeAssist.FitRadius="{DynamicResource RadiusBadgeValue}">
            <TextBlock Text="{Binding Number}" FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource SizeMono}"
                       Foreground="{Binding NumberForeground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding MapName}" FontSize="{DynamicResource SizeBodyL}" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"/>
              <Border Visibility="{Binding PackVisibility}" Style="{StaticResource Tag}" BorderBrush="{DynamicResource Edge}"
                      Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock views:TextEffects.Tracked="{Binding Pack}" Style="{StaticResource Caps}"
                           Foreground="{DynamicResource Muted}"/>
              </Border>
              <TextBlock views:TextEffects.Tracked="&#x25B6; NOW" Visibility="{Binding NowVisibility}"
                         Style="{StaticResource Caps}" Foreground="{DynamicResource Ok}" Effect="{DynamicResource TextGlow}"
                         Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding Line}" Style="{StaticResource Mono}" Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <Border Grid.Column="3" Style="{StaticResource Tag}" Background="{DynamicResource TagBg}"
                  BorderBrush="{DynamicResource TagEdge}" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
            <TextBlock views:TextEffects.Tracked="{Binding GametypeCaps}" Style="{StaticResource TagText}"
                       FontSize="{DynamicResource SizeLabelL}"/>
          </Border>

          <TextBlock Grid.Column="4" Text="{Binding Limit}" Style="{StaticResource Mono}" Width="52"
                     TextAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>

          <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource RowIcon}" Content="&#x2912;" Command="{Binding TopCommand}"
                    ToolTip="Move to top" Margin="0"/>
            <Button Style="{StaticResource RowIcon}" Content="&#x25B2;" FontSize="9" Command="{Binding UpCommand}"
                    ToolTip="Move up"/>
            <Button Style="{StaticResource RowIcon}" Content="&#x25BC;" FontSize="9" Command="{Binding DownCommand}"
                    ToolTip="Move down"/>
            <Button Style="{StaticResource RowRemove}" Content="&#x2715;" Command="{Binding RemoveCommand}"
                    ToolTip="Remove"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="72"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="392"/>
      </Grid.ColumnDefinitions>

      <!-- ── left: name, mode, port, rotation ─────────────────────────────── -->
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}"
                  BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock views:TextEffects.Tracked="01 &#xB7; SERVER NAME" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius}">
                  <DockPanel views:ThemeAssist.ClipRadius="{DynamicResource RadiusValue}">
                    <Rectangle DockPanel.Dock="Left" Width="3" Fill="{DynamicResource Fill}"/>
                    <TextBox x:Name="txtName" Style="{StaticResource Entry}" BorderThickness="0"
                             Background="Transparent" FontSize="{DynamicResource SizeBodyL}" Padding="10,8"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                  </DockPanel>
                </Border>
                <DockPanel Margin="0,8,0,0">
                  <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Swatches}"
                                ItemTemplate="{StaticResource SwatchTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <TextBlock DockPanel.Dock="Left" views:TextEffects.Tracked="IN BROWSER"
                             Margin="8,0,10,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Caps}">
                        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
                        <Style.Triggers>
                          <DataTrigger Value="True"
                                       Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=views:EditorView}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                          BorderThickness="1" Padding="8,2" CornerRadius="{DynamicResource Radius}">
                    <TextBlock views:TextEffects.ColorName="{Binding Name}" FontSize="{DynamicResource SizeBody}"
                               TextTrimming="CharacterEllipsis"/>
                  </Border>
                </DockPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="0,0,14,0">
                <TextBlock views:TextEffects.Tracked="MODE" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                <Border Style="{StaticResource SegmentGroup}" Height="36">
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Segment}" Content="MULTIPLAYER" Padding="14,0"
                            Command="{Binding SetMultiplayerCommand}"
                            views:ThemeAssist.Active="{Binding IsMultiplayer, Mode=OneWay}"/>
                    <Button Style="{StaticResource Segment}" Content="ZOMBIES" Padding="14,0"
                            Command="{Binding SetZombiesCommand}"
                            views:ThemeAssist.Active="{Binding IsZombies, Mode=OneWay}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock views:TextEffects.Tracked="UDP PORT" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                <TextBox Width="92" Height="36" Style="{StaticResource Number}" FontSize="{DynamicResource SizeBodyL}"
                         Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding PortWarning}" Visibility="{Binding PortWarningVisibility}"
                           FontSize="{DynamicResource SizeBodyXS}" Foreground="{DynamicResource Accent}" Margin="0,5,0,0"
                           MaxWidth="150" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,12">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Style="{StaticResource Greyed}" IsEnabled="{Binding ShuffleEnabled}">
                  <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ShuffleOnLaunch, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                  <TextBlock FontSize="{DynamicResource SizeBodyXS}" Foreground="{DynamicResource Label}"
                             Margin="8,0,14,0" VerticalAlignment="Center" ToolTip="Shuffle on every launch">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Shuffle on every launch"/>
                        <Style.Triggers>
                          <DataTrigger Value="True"
                                       Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=views:EditorView}}">
                            <Setter Property="Text" Value="Shuffle"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <Button Style="{StaticResource Outline}" Content="&#x2928; RANDOMIZE"
                        Padding="12,6" Command="{Binding RandomizeCommand}"/>
                <Button Style="{StaticResource Link}" Content="Clear all" Margin="14,0,0,0"
                        Command="{Binding ClearCommand}"/>
              </StackPanel>
              <!-- The meta line is last so it takes what is left and trims, instead of growing
                   under the controls on the right. -->
              <DockPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock DockPanel.Dock="Left" views:TextEffects.Tracked="{Binding RotationTitle, StringFormat=02 &#xB7; {0}}"
                           Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding RotationCount}" Style="{StaticResource Mono}" FontSize="{DynamicResource SizeMonoL}"
                           Foreground="{DynamicResource Accent}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RotationMeta}" Style="{StaticResource Mono}" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </DockPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="96"/>
              </Grid.ColumnDefinitions>
              <ComboBox Grid.Column="0" Style="{StaticResource Picker}" Margin="0,0,8,0"
                        ItemsSource="{Binding MapOptions}" SelectedItem="{Binding PickedMap, Mode=TwoWay}"
                        DisplayMemberPath="Label"/>
              <ComboBox Grid.Column="1" Style="{StaticResource Picker}" Margin="0,0,8,0"
                        ItemsSource="{Binding GametypeOptions}" SelectedItem="{Binding PickedGametype, Mode=TwoWay}"
                        DisplayMemberPath="Label"/>
              <Button Grid.Column="2" Style="{StaticResource Primary}" Content="+ ADD" Height="36" Padding="8,0"
                      Command="{Binding AddCommand}"/>
            </Grid>

            <Grid Grid.Row="2">
              <Rectangle Width="1" Fill="{DynamicResource Line}" HorizontalAlignment="Left" Margin="47,0,0,0"/>
              <!-- A drop a row did not take is a drop into the space under the list: the end. -->
              <ListBox x:Name="lstRotation" Style="{StaticResource RotationList}"
                       views:DragReorder.EndZone="True"
                       ItemsSource="{Binding Rotation}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                       ItemTemplate="{StaticResource RotationRowTemplate}"/>
              <Grid Visibility="{Binding EmptyRotationVisibility}" VerticalAlignment="Top" Height="86">
                <Rectangle Fill="{DynamicResource Panel}" Stroke="{DynamicResource Line}" StrokeThickness="1"
                           StrokeDashArray="4 3" RadiusX="{DynamicResource RadiusValue}" RadiusY="{DynamicResource RadiusValue}"/>
                <TextBlock Text="Empty rotation. Pick a map and a mode above, then Add." FontSize="{DynamicResource SizeBodyS}"
                           Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <!-- ── right: rules, bots, lobby, visibility, advanced ──────────────── -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>

          <StackPanel Visibility="{Binding MultiplayerVisibility}">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
              <StackPanel>
                <DockPanel Margin="20,14,20,10">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreSummary}" Style="{StaticResource Mono}"/>
                  <TextBlock views:TextEffects.Tracked="03 &#xB7; MATCH RULES" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <StackPanel Margin="20,0,20,16">
                  <TextBlock Text="Score limits for the modes in this rotation." FontSize="{DynamicResource SizeBodyXS}"
                             Foreground="{DynamicResource Dim}" Margin="0,0,0,10"/>
                  <ItemsControl ItemsSource="{Binding ScoreRows}" ItemTemplate="{StaticResource ScoreRowTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding DomVisibility}">
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SingleRoundDom, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="Single-round Domination (no halftime)" FontSize="{DynamicResource SizeBodyS}"
                               Foreground="{DynamicResource Label}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
              <StackPanel>
                <DockPanel Margin="20,14,20,10">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding BotSummary}" Style="{StaticResource Mono}"/>
                  <TextBlock views:TextEffects.Tracked="04 &#xB7; BOTS" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <StackPanel Margin="20,0,20,16">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding BotFill}" FontFamily="{DynamicResource FontMono}"
                               FontSize="{DynamicResource SizeMonoXL}" Foreground="{DynamicResource Accent}"
                               Effect="{DynamicResource TextGlow}"/>
                    <TextBlock Text="Bot fill" FontSize="{DynamicResource SizeBodyS}" Foreground="{DynamicResource Label}"
                               VerticalAlignment="Bottom"/>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding BotPips}" ItemTemplate="{StaticResource PipTemplate}"
                                Margin="0,8,-2,6">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <Slider Style="{StaticResource FillSlider}" Minimum="0" Maximum="{Binding Cap}"
                          Value="{Binding BotFill, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                  <DockPanel Margin="0,2,0,14">
                    <TextBlock DockPanel.Dock="Left" Text="0" Style="{StaticResource Mono}" FontSize="{DynamicResource SizeMonoS}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Cap}" Style="{StaticResource Mono}" FontSize="{DynamicResource SizeMonoS}"/>
                    <TextBlock Text="bots leave as humans join" Style="{StaticResource Mono}" FontSize="{DynamicResource SizeMonoS}"
                               HorizontalAlignment="Center"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,10">
                    <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}" Height="28">
                      <ItemsControl ItemsSource="{Binding PoolOptions}" ItemTemplate="{StaticResource SegmentTemplate}" Margin="-1,0,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </Border>
                    <TextBlock Text="Name pool" FontSize="{DynamicResource SizeBodyS}" Foreground="{DynamicResource Label}"
                               VerticalAlignment="Center"/>
                  </DockPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}" Height="28">
                      <ItemsControl ItemsSource="{Binding DifficultyOptions}" ItemTemplate="{StaticResource SegmentTemplate}" Margin="-1,0,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </Border>
                    <TextBlock Text="Difficulty" FontSize="{DynamicResource SizeBodyS}" Foreground="{DynamicResource Label}"
                               VerticalAlignment="Center"/>
                  </DockPanel>
                  <!-- With this on, s2x_autobalance.gsc runs the bots and bot fill is the match size. -->
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Style="{StaticResource Greyed}"
                              IsEnabled="{Binding AutoBalanceEnabled}">
                    <ToggleButton x:Name="tglAutoBalance" Style="{StaticResource Switch}"
                                  IsChecked="{Binding AutoBalance, Mode=TwoWay}" VerticalAlignment="Center"/>
                    <TextBlock Text="Auto-balance" FontSize="{DynamicResource SizeBodyXS}" Foreground="{DynamicResource Label}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Text="{Binding AutoBalanceNote}" Visibility="{Binding AutoBalanceNoteVisibility}"
                             FontSize="{DynamicResource SizeBodyXS}" Foreground="{DynamicResource Dim}" TextWrapping="Wrap"
                             Margin="40,8,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <StackPanel>
              <DockPanel Margin="20,14,20,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding LobbySummary}" Style="{StaticResource Mono}"/>
                <TextBlock views:TextEffects.Tracked="{Binding LobbyNumber, StringFormat={}{0} &#xB7; LOBBY}"
                           Style="{StaticResource SectionTitle}"/>
              </DockPanel>
              <!-- A profile server's party is the package's, so there is nothing to type here. -->
              <TextBlock Text="{Binding LobbyText}" Visibility="{Binding LobbyTextVisibility}" FontSize="{DynamicResource SizeBodyS}"
                         Foreground="{DynamicResource Label}" TextWrapping="Wrap" Margin="20,0,20,16"/>
              <StackPanel Margin="20,0,20,16" Visibility="{Binding LobbyFieldsVisibility}">
                <DockPanel>
                  <TextBox DockPanel.Dock="Right" Width="52" Style="{StaticResource Number}"
                           Text="{Binding CapText, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock FontSize="{DynamicResource SizeBodyS}" Foreground="{DynamicResource Label}" VerticalAlignment="Center">
                    <Run Text="Player cap "/><Run Text="{Binding CapRange, Mode=OneWay}" Foreground="{DynamicResource Faint}"/>
                  </TextBlock>
                </DockPanel>
                <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="{DynamicResource Line}"
                      StrokeThickness="1" StrokeDashArray="1 2" Margin="0,6,0,8"/>
                <DockPanel>
                  <TextBox DockPanel.Dock="Right" Width="52" Style="{StaticResource Number}"
                           Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Minimum players to start" FontSize="{DynamicResource SizeBodyS}" Foreground="{DynamicResource Label}"
                             VerticalAlignment="Center"/>
                </DockPanel>
                <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="{DynamicResource Line}"
                      StrokeThickness="1" StrokeDashArray="1 2" Margin="0,6,0,8"/>
                <DockPanel>
                  <TextBox DockPanel.Dock="Right" Width="52" Style="{StaticResource Number}"
                           Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock FontSize="{DynamicResource SizeBodyS}" Foreground="{DynamicResource Label}" VerticalAlignment="Center">
                    <Run Text="Countdown "/><Run Text="0-120 s" Foreground="{DynamicResource Faint}"/>
                  </TextBlock>
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <StackPanel>
              <DockPanel Margin="20,14,20,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding VisibilitySummary}" FontFamily="{DynamicResource FontMono}"
                           FontSize="{DynamicResource SizeMono}" Foreground="{Binding VisibilityBrush}"/>
                <TextBlock views:TextEffects.Tracked="{Binding VisibilityNumber, StringFormat={}{0} &#xB7; VISIBILITY}"
                           Style="{StaticResource SectionTitle}"/>
              </DockPanel>
              <StackPanel Margin="20,0,20,16">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Advertise, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                  <TextBlock Text="Advertise on the master list" FontSize="{DynamicResource SizeBodyS}" Foreground="{DynamicResource Label}"
                             Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding VisibilityNote}" FontSize="{DynamicResource SizeBodyXS}" Foreground="{DynamicResource Dim}"
                           TextWrapping="Wrap" Margin="40,8,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <StackPanel>
              <DockPanel Margin="20,14,20,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding AdvancedSummary}" Style="{StaticResource Mono}"/>
                <TextBlock views:TextEffects.Tracked="{Binding AdvancedNumber, StringFormat={}{0} &#xB7; ADVANCED}"
                           Style="{StaticResource SectionTitle}"/>
              </DockPanel>
              <TextBlock Text="Not available for profile servers: the profile writes its own cfg."
                         Visibility="{Binding AdvancedNoteVisibility}" FontSize="{DynamicResource SizeBodyXS}" Foreground="{DynamicResource Dim}"
                         TextWrapping="Wrap" Margin="20,0,20,8"/>
              <StackPanel Margin="20,0,20,16" Style="{StaticResource Greyed}" IsEnabled="{Binding AdvancedEnabled}">
                <Grid>
                  <TextBox Style="{StaticResource Entry}" Height="80" AcceptsReturn="True"
                           Background="{DynamicResource Bar}" FontFamily="{DynamicResource FontMono}" FontSize="{DynamicResource SizeMonoL}"
                           VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"
                           Text="{Binding ExtraText, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="one dvar per line, e.g.  set g_speed 190" IsHitTestVisible="False"
                             Visibility="{Binding ExtraPlaceholderVisibility}" Style="{StaticResource Mono}" FontSize="{DynamicResource SizeMonoL}"
                             Margin="10,9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBlock Text="!" FontWeight="Bold" FontSize="{DynamicResource SizeBodyXS}" Foreground="{DynamicResource Danger}"
                             Margin="0,0,6,0"/>
                  <TextBlock Text="Passed through as written. Nothing here is checked." FontSize="{DynamicResource SizeBodyXS}"
                             Foreground="{DynamicResource Danger}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Margin="20,16,20,16">
            <TextBlock views:TextEffects.Tracked="WRITES TO" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding WritesTo}" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- The console drawer, under the editor and over its footer: the editor screen and the
         roster's pane. On the fleet's cards the same drawer is the one FleetView holds. -->
    <views:ConsoleDrawer Grid.Row="1" DataContext="{Binding Fleet.Console}"
                         Height="{Binding Height}"
                         Visibility="{Binding EditorVisibility, FallbackValue=Collapsed}"/>

    <!-- ── footer ────────────────────────────────────────────────────────── -->
    <Border Grid.Row="2" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,1,0,0">
      <DockPanel Margin="20,0" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <views:StatusBadge Foreground="{Binding StateBrush}" Background="{Binding StateTint}" Pulse="{Binding IsRunning}">
            <TextBlock views:TextEffects.Tracked="{Binding StateCaps}"/>
          </views:StatusBadge>
          <TextBlock Text="{Binding StatusSub}" Style="{StaticResource Mono}" Margin="0,5,0,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Left" Visibility="{Binding DirtyVisibility}" Margin="14,0,0,0"
                Style="{StaticResource Tag}" Background="{DynamicResource TagBg}" BorderBrush="{DynamicResource TagEdge}"
                Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="&#x25CF; UNSAVED" Style="{StaticResource TagText}" FontSize="{DynamicResource SizeLabelL}"/>
        </Border>
        <!-- Somebody else wrote this preset while it was open here. -->
        <Border DockPanel.Dock="Left" Visibility="{Binding FileChangedVisibility}" Margin="8,0,0,0"
                Style="{StaticResource Tag}" Background="{DynamicResource DangerBg}" BorderBrush="{DynamicResource DangerEdge}"
                Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="FILE CHANGED ON DISK" Style="{StaticResource TagText}" FontSize="{DynamicResource SizeLabelL}"
                     Foreground="{DynamicResource Danger}"/>
        </Border>

        <!-- 44 px buttons centred in the bar, as the pack draws its buttons: the fill's glow
             then has room round it instead of running into the window's edge. -->
        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="&#x25B6; LAUNCH SERVER"
                Height="44" VerticalAlignment="Center" Padding="24,0"
                Visibility="{Binding LaunchVisibility}" Command="{Binding LaunchCommand}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="&#x21BB; RESTART"
                Height="44" VerticalAlignment="Center" Padding="24,0"
                Visibility="{Binding RunningVisibility}" Command="{Binding RestartCommand}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource DangerGhost}" Content="&#x25A0; STOP"
                Height="44" VerticalAlignment="Center" Padding="18,0" Margin="0,0,8,0"
                Visibility="{Binding RunningVisibility}" Command="{Binding StopCommand}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource Outline}" Content="SAVE AS&#x2026;"
                Height="44" VerticalAlignment="Center" Padding="14,0" Margin="0,0,14,0"
                Command="{Binding SaveAsCommand}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource Outline}" Content="SAVE PRESET"
                Height="44" VerticalAlignment="Center" Padding="14,0" Margin="0,0,8,0"
                ToolTip="Ctrl+S" Command="{Binding SaveCommand}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource Outline}" Content="CONSOLE"
                Height="44" VerticalAlignment="Center" Padding="14,0" Margin="0,0,14,0"
                ToolTip="This server's log, as it is written" Command="{Binding ConsoleCommand}"/>
        <!-- Only with nothing running on the port: the preset file is what the server is. -->
        <Button DockPanel.Dock="Right" Style="{StaticResource DangerGhost}" Content="DELETE PRESET"
                Height="44" VerticalAlignment="Center" Padding="14,0" Margin="0,0,14,0"
                Visibility="{Binding DeleteVisibility}" Command="{Binding DeleteCommand}"
                ToolTip="Delete this preset file, and the port's cfg and pid if nothing else claims it"/>
      </DockPanel>
    </Border>

    <!-- the fleet's toast, over the editor too -->
    <Border Grid.RowSpan="3" Visibility="{Binding Fleet.ToastVisibility}" Background="{DynamicResource Field}"
            BorderBrush="{DynamicResource EdgeHot}" BorderThickness="1" Padding="14,8" CornerRadius="{DynamicResource Radius}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,90">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#x2713;" Foreground="{DynamicResource Ok}" Margin="0,0,10,0"/>
        <TextBlock Text="{Binding Fleet.ToastText}" FontSize="{DynamicResource SizeBodyS}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
