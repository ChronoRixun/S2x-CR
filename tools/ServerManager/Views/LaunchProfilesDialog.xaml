<Window x:Class="S2x.ServerManager.Views.LaunchProfilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:S2x.ServerManager.Views"
        Title="S2x Server Manager" Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
        BorderBrush="{StaticResource WindowEdge}" BorderThickness="1"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- one registered folder: what it offers, where it is, and what is wrong with it -->
    <DataTemplate x:Key="ProfileTemplate">
      <Border Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}" BorderThickness="1"
              Padding="14,10" Margin="0,0,0,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Remove" Click="RemovePicked"
                  VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="Unregister this folder. Nothing in it is touched."/>
          <StackPanel>
            <TextBlock Text="{Binding Summary}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Folder}" Style="{StaticResource Mono}" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}"/>
            <TextBlock Text="{Binding Problem}" Visibility="{Binding ProblemVisibility}" FontSize="11"
                       Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <StackPanel>
    <Border x:Name="barTitle" Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,0,0,1" Padding="16,0" Height="36">
      <TextBlock views:TextEffects.Tracked="LAUNCH PROFILES" FontSize="10.5" FontWeight="Bold"
                 Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Margin="20,16,20,18">
      <TextBlock FontSize="12.5" Foreground="{StaticResource Label}" TextWrapping="Wrap" LineHeight="18"
                 Margin="0,0,0,12"
                 Text="A launch profile is a separately installed server package that starts its own servers. Register its folder here and its modes show in the editor's mode list."/>
      <ItemsControl x:Name="lstProfiles" ItemTemplate="{StaticResource ProfileTemplate}"/>
      <TextBlock x:Name="lblEmpty" Text="No launch profiles registered." FontSize="12" Foreground="{StaticResource Dim}"
                 Margin="0,0,0,8"/>
      <TextBlock x:Name="lblMessage" FontSize="11.5" Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                 Visibility="Collapsed" Margin="0,0,0,8"/>
      <DockPanel Margin="0,8,0,0">
        <Button DockPanel.Dock="Right" x:Name="btnClose" Style="{StaticResource Primary}" Content="CLOSE"
                IsCancel="True" IsDefault="True"/>
        <Button DockPanel.Dock="Right" x:Name="btnAdd" Style="{StaticResource Outline}" Content="ADD&#x2026;"
                Margin="0,0,8,0" ToolTip="Pick a folder that holds server-manager.json"/>
        <TextBlock x:Name="lblFile" Style="{StaticResource Mono}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
      </DockPanel>
    </StackPanel>
  </StackPanel>
</Window>
