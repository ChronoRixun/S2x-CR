<Window x:Class="S2x.ServerManager.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:S2x.ServerManager.Views"
        Title="S2x Server Manager" Width="420" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ThemedWindow}"
        BorderBrush="{DynamicResource WindowEdge}" BorderThickness="1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <StackPanel>
    <Border x:Name="barTitle" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,0,0,1" Padding="16,0" Height="36">
      <TextBlock x:Name="lblTitle" views:TextEffects.Tracked="SAVE AS" Style="{StaticResource CapsL}"
                 Foreground="{DynamicResource Accent}" Effect="{DynamicResource TextGlow}" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Margin="20,18,20,18">
      <TextBlock x:Name="lblLabel" Text="Preset name" FontSize="{DynamicResource SizeBodyS}" Foreground="{DynamicResource Label}"/>
      <TextBox x:Name="txtValue" Style="{StaticResource Entry}" Margin="0,8,0,0" FontSize="{DynamicResource SizeBodyL}"/>
      <TextBlock Text="Written to the presets folder both launchers read."
                 FontSize="{DynamicResource SizeBodyXS}" Foreground="{DynamicResource Dim}" Margin="0,8,0,0"/>
      <DockPanel Margin="0,18,0,0" LastChildFill="False">
        <Button DockPanel.Dock="Right" x:Name="btnOk" Style="{StaticResource Primary}" Content="SAVE" IsDefault="True"/>
        <Button DockPanel.Dock="Right" x:Name="btnCancel" Style="{StaticResource Outline}" Content="CANCEL"
                IsCancel="True" Margin="0,0,8,0"/>
      </DockPanel>
    </StackPanel>
  </StackPanel>
</Window>
