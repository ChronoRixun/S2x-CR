<Window x:Class="S2x.ServerManager.Views.MasterBrowserWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="S2x — Master list" Width="1060" Height="650" MinWidth="820" MinHeight="450"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Panel}"
 Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="MASTER LIST" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock Text="Servers advertised on S2x, with their current maps and population." Foreground="{DynamicResource Muted}" Margin="0,6,0,16"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
    <Button Content="REFRESH" Style="{StaticResource Flat}" Command="{Binding RefreshCommand}" Padding="16,8" Margin="0,0,8,0"/>
    <Button Content="CANCEL" Style="{StaticResource Flat}" Command="{Binding CancelCommand}" Padding="12,8"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="SEARCH SERVER, MAP OR ADDRESS" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
    <TextBox Style="{StaticResource Entry}" AutomationProperties.Name="Search servers" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,12,0" ToolTip="Filter the current results"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="GAME" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
    <ComboBox Style="{StaticResource Picker}" AutomationProperties.Name="Game filter" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Padding="8" Margin="0,0,12,0"/></StackPanel>
   <Button Grid.Column="2" Content="COPY CONNECT" Style="{StaticResource Flat}" Command="{Binding CopyCommand}" VerticalAlignment="Bottom" Padding="12,8" ToolTip="Copy a console connect command for the selected server"/>
  </Grid>
  <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredRows}" SelectedItem="{Binding Selected}"
    IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
    CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
    GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}"
    Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}"
    BorderBrush="{DynamicResource Edge}" BorderThickness="1" RowBackground="{DynamicResource Panel}"
    AlternatingRowBackground="{DynamicResource Row}" HeadersVisibility="Column">
   <DataGrid.Resources>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Bar}"/><Setter Property="Foreground" Value="{DynamicResource Label}"/><Setter Property="Padding" Value="9,10"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="42"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource TagBg}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></Style.Triggers></Style>
   </DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="SERVER" Binding="{Binding Name}" Width="2*" MinWidth="160"/>
    <DataGridTextColumn Header="MAP" Binding="{Binding Map}" Width="1.4*" MinWidth="145"/>
    <DataGridTextColumn Header="MODE" Binding="{Binding Mode}" Width="90"/>
    <DataGridTextColumn Header="HUMANS" Binding="{Binding Humans}" Width="76"/>
    <DataGridTextColumn Header="BOTS" Binding="{Binding Bots}" Width="54"/>
    <DataGridTextColumn Header="LIMIT" Binding="{Binding Capacity}" Width="56"/>
    <DataGridTextColumn Header="PING" Binding="{Binding Ping}" Width="66"/>
    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="85"/>
   </DataGrid.Columns>
   <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Endpoint}"/></Style></DataGrid.RowStyle>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="0,13,0,0">
   <DockPanel><TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/><TextBlock Text="{Binding Updated}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></DockPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/>
  </StackPanel>
 </Grid>
</Window>
