<Window x:Class="S2x.ServerManager.Views.MasterBrowserWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:S2x.ServerManager.Views"
 Title="S2x — Master list" Width="1060" Height="650" MinWidth="820" MinHeight="450"
 WindowStartupLocation="CenterOwner" Style="{StaticResource ThemedWindow}"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="MASTER LIST" Style="{StaticResource Display}"/>
    <TextBlock Text="Servers advertised on S2x, with their current maps and population." Foreground="{DynamicResource Muted}" Margin="0,6,0,16"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
    <Button Content="REFRESH" Style="{StaticResource Primary}" Command="{Binding RefreshCommand}" Padding="18,9" Margin="0,0,8,0"/>
    <Button Content="CANCEL" Style="{StaticResource Outline}" Command="{Binding CancelCommand}" Padding="14,8"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock views:TextEffects.Tracked="SEARCH SERVER, MAP OR ADDRESS" Style="{StaticResource Caps}" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
    <TextBox Style="{StaticResource Entry}" AutomationProperties.Name="Search servers" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,12,0" ToolTip="Filter the current results"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock views:TextEffects.Tracked="GAME" Style="{StaticResource Caps}" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
    <ComboBox Style="{StaticResource Picker}" AutomationProperties.Name="Game filter" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Padding="8" Margin="0,0,12,0"/></StackPanel>
   <Button Grid.Column="2" Content="COPY CONNECT" Style="{StaticResource Outline}" Command="{Binding CopyCommand}" VerticalAlignment="Bottom" Padding="12,9" ToolTip="Copy a console connect command for the selected server"/>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource Radius}" Background="{DynamicResource Bar}">
  <DataGrid ItemsSource="{Binding FilteredRows}" SelectedItem="{Binding Selected}" views:ThemeAssist.ClipRadius="{DynamicResource RadiusValue}"
    IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
    CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
    GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}"
    Background="{DynamicResource Bar}" Foreground="{DynamicResource Ink}"
    BorderThickness="0" RowBackground="{DynamicResource Bar}"
    AlternatingRowBackground="{DynamicResource Row}" HeadersVisibility="Column">
   <DataGrid.Resources>
    <Style x:Key="GridTrim" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="9,10"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FontFamily" Value="{DynamicResource FontLabel}"/><Setter Property="FontWeight" Value="{DynamicResource FontLabelWeight}"/><Setter Property="FontStretch" Value="{DynamicResource FontLabelStretch}"/><Setter Property="FontSize" Value="{DynamicResource SizeLabelL}"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="42"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource TagBg}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Setter Property="Padding" Value="8,9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style>
   </DataGrid.Resources>
   <DataGrid.Columns>
    <!-- The short columns size to their header and cells in the theme's fonts; server and map
         share the rest and trim. Fixed widths cut "Responded" in Arcade's wider body font. -->
    <DataGridTextColumn Header="SERVER" Binding="{Binding Name}" Width="2*" MinWidth="140" ElementStyle="{StaticResource GridTrim}"/>
    <DataGridTextColumn Header="MAP" Binding="{Binding Map}" Width="1.4*" MinWidth="120" ElementStyle="{StaticResource GridTrim}"/>
    <DataGridTextColumn Header="MODE" Binding="{Binding Mode}" Width="Auto" MinWidth="80"/>
    <DataGridTextColumn Header="HUMANS" Binding="{Binding Humans}" Width="Auto" MinWidth="64"/>
    <DataGridTextColumn Header="BOTS" Binding="{Binding Bots}" Width="Auto" MinWidth="50"/>
    <DataGridTextColumn Header="LIMIT" Binding="{Binding Capacity}" Width="Auto" MinWidth="54"/>
    <DataGridTextColumn Header="PING" Binding="{Binding Ping}" Width="Auto" MinWidth="60"/>
    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="Auto" MinWidth="84"/>
   </DataGrid.Columns>
   <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Endpoint}"/></Style></DataGrid.RowStyle>
  </DataGrid>
  </Border>
  <StackPanel Grid.Row="3" Margin="0,13,0,0">
   <DockPanel><TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/><TextBlock Text="{Binding Updated}" Style="{StaticResource Mono}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></DockPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource SizeBodyS}" Margin="0,7,0,0"/>
  </StackPanel>
 </Grid>
</Window>
