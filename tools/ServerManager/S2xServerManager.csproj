<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One exe, no DLLs beside it: nothing here but the framework.
    Build:  dotnet build tools/ServerManager/S2xServerManager.csproj -c Release
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>S2xServerManager</AssemblyName>
    <RootNamespace>S2x.ServerManager</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>S2x Server Manager</AssemblyTitle>
    <Product>S2x Server Manager</Product>
    <Company>S2x community</Company>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <ApplicationIcon>Assets\S2xServerManager.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- In-box only: WMI for the command line behind a pid, JavaScriptSerializer for presets. -->
    <Reference Include="System.Management" />
    <!-- JavaScriptSerializer lives in System.Web.Extensions; the XAML compiler wants the
         assembly it references too. Both are in the framework, so nothing ships beside the exe. -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <!-- Server scripts ride inside the exe and are written into the game folder when a server
         needs them (Services\ServerScriptInstaller.cs), so the release is still one file. -->
    <EmbeddedResource Include="ServerScripts\s2x_autobalance.gsc"
                      LogicalName="S2x.ServerManager.ServerScripts.s2x_autobalance.gsc" />
    <!-- Theme pack fonts, built into the exe as WPF Resources (still one file). Drop the .ttf/.otf
         files listed in Assets/Fonts/README.md into that folder; the wildcards pick them up and
         Services/ThemeFonts.cs uses any family it finds there instead of its Windows fallback.
         Their licence texts go in Assets/Fonts/licenses and ship inside the exe the same way. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\*.otf" />
    <Resource Include="Assets\Fonts\licenses\*.txt" />
  </ItemGroup>

</Project>
