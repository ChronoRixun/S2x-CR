<Window x:Class="S2x.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:S2x.ServerManager.Views"
        Title="S2x Server Manager"
        Width="1160" Height="740" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
        BorderBrush="{StaticResource WindowEdge}" BorderThickness="1"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveEditorCommand}"/>
    <KeyBinding Key="Escape" Command="{Binding CloseConsoleCommand}"/>
    <KeyBinding Key="L" Modifiers="Control" Command="{Binding FocusConsoleFilterCommand}"/>
    <KeyBinding Key="F5" Command="{Binding PollNowCommand}"/>
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Title bar: no WindowChrome, drag and caption buttons wired in code. -->
    <Border x:Name="barTitle" Background="{StaticResource Bar}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False">
        <Border DockPanel.Dock="Left" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="16,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Polygon Points="0,0 10,0 10,10" Fill="{StaticResource Accent}" Margin="0,0,10,0"/>
            <TextBlock views:TextEffects.Tracked="S2x" FontWeight="Bold" FontSize="13"/>
          </StackPanel>
        </Border>
        <Button DockPanel.Dock="Left" Style="{StaticResource Flat}" Content="&#x2039; FLEET"
                Visibility="{Binding BackVisibility}" Command="{Binding BackCommand}"
                Foreground="{StaticResource Accent}" Padding="14,0"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"/>
        <TextBlock DockPanel.Dock="Left" Margin="16,0" VerticalAlignment="Center"
                   views:TextEffects.Tracked="{Binding Breadcrumb}"
                   FontSize="10.5" FontWeight="SemiBold" Foreground="#FF7C858C"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="txtVersion" DockPanel.Dock="Left" VerticalAlignment="Center"
                   FontSize="9.5" Foreground="{StaticResource Dim}"/>

        <Button DockPanel.Dock="Right" x:Name="btnClose" Style="{StaticResource CaptionClose}" Content="&#x2715;"/>
        <Button DockPanel.Dock="Right" x:Name="btnMaximize" Style="{StaticResource Caption}" Content="&#x2610;" FontSize="11"/>
        <Button DockPanel.Dock="Right" x:Name="btnMinimize" Style="{StaticResource Caption}" Content="&#x2014;"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Clock}" Style="{StaticResource Mono}"
                   VerticalAlignment="Center" Margin="0,0,16,0"/>
        <!-- Up here rather than beside + New server: that row is full at the default width once
             SHOW HIDDEN is in it, and this reaches the editor screen too. -->
        <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Command="{Binding LaunchProfilesCommand}"
                Foreground="{StaticResource Muted}" Padding="14,0" Margin="0,0,8,0"
                BorderBrush="{StaticResource Line}" BorderThickness="1,0,1,0"
                ToolTip="Server packages that start their own servers">
          <TextBlock views:TextEffects.Tracked="LAUNCH PROFILES&#x2026;" FontSize="10" FontWeight="SemiBold"/>
        </Button>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <views:FleetView Visibility="{Binding FleetVisibility}"/>
      <views:EditorView DataContext="{Binding Editor}"
                        Visibility="{Binding DataContext.EditorVisibility,
                                     RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
  </Grid>
</Window>
