<Window x:Class="S2x.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:S2x.ServerManager.Views"
        Title="S2x Server Manager"
        Width="1160" Height="740" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Style="{StaticResource ThemedWindow}"
        BorderBrush="{DynamicResource WindowEdge}" BorderThickness="1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveEditorCommand}"/>
    <KeyBinding Key="Escape" Command="{Binding CloseConsoleCommand}"/>
    <KeyBinding Key="L" Modifiers="Control" Command="{Binding FocusConsoleFilterCommand}"/>
    <KeyBinding Key="F5" Command="{Binding PollNowCommand}"/>
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Title bar: no WindowChrome, drag and caption buttons wired in code. -->
    <Border x:Name="barTitle" Background="{DynamicResource Bar}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <!-- The right-hand controls are docked first, so a long editor breadcrumb trims itself
           instead of pushing LAUNCH PROFILES off the bar. -->
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Right" x:Name="btnClose" Style="{StaticResource CaptionClose}" Content="&#x2715;" Height="44"/>
        <Button DockPanel.Dock="Right" x:Name="btnMaximize" Style="{StaticResource Caption}" Content="&#x2610;" FontSize="11" Height="44"/>
        <Button DockPanel.Dock="Right" x:Name="btnMinimize" Style="{StaticResource Caption}" Content="&#x2014;" Height="44"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Clock}" Style="{StaticResource Mono}" Foreground="{DynamicResource Muted}"
                   VerticalAlignment="Center" Margin="6,0,14,0"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Click="OpenSettings"
                Foreground="{DynamicResource Muted}" Padding="14,0" ToolTip="Themes and application settings">
          <TextBlock views:TextEffects.Tracked="SETTINGS" FontSize="{DynamicResource SizeLabel}"/>
        </Button>
        <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Click="OpenMasterList"
                Foreground="{DynamicResource Muted}" Padding="14,0" ToolTip="Browse advertised S2x servers and their current maps">
          <TextBlock views:TextEffects.Tracked="MASTER LIST" FontSize="{DynamicResource SizeLabel}"/>
        </Button>
        <!-- Up here rather than beside + New server: that row is full at the default width once
             SHOW HIDDEN is in it, and this reaches the editor screen too. -->
        <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Command="{Binding LaunchProfilesCommand}"
                Foreground="{DynamicResource Muted}" Padding="16,0" Margin="0,0,4,0"
                BorderBrush="{DynamicResource Line}" BorderThickness="1,0,1,0"
                ToolTip="Server packages that start their own servers">
          <TextBlock views:TextEffects.Tracked="LAUNCH PROFILES&#x2026;" FontSize="{DynamicResource SizeLabel}"/>
        </Button>

        <Border DockPanel.Dock="Left" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="18,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Polygon Points="0,0 12,0 12,12" Fill="{DynamicResource Fill}" Effect="{DynamicResource Glow}"
                     Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="S2x" Style="{StaticResource Display}" FontSize="{DynamicResource SizeBrand}"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Button DockPanel.Dock="Left" Style="{StaticResource Flat}" Content="&#x2039; FLEET"
                Visibility="{Binding BackVisibility}" Command="{Binding BackCommand}"
                Foreground="{DynamicResource Accent}" Padding="14,0"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"/>
        <TextBlock DockPanel.Dock="Left" Margin="18,0,12,0" VerticalAlignment="Center"
                   views:TextEffects.Tracked="{Binding Breadcrumb}" Style="{StaticResource CapsL}"
                   Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="txtVersion" DockPanel.Dock="Left" VerticalAlignment="Center"
                   Style="{StaticResource Mono}" Foreground="{DynamicResource Muted}"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <views:FleetView Visibility="{Binding FleetVisibility}"/>
      <views:EditorView DataContext="{Binding Editor}"
                        Visibility="{Binding DataContext.EditorVisibility,
                                     RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
  </Grid>
</Window>
