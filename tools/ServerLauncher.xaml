<!--
  S2x Dedicated Server Launcher — WPF layout
  Loaded at runtime by server-launcher.ps1 via XamlReader.Load.

  Deliberately conservative so it parses with no compiled assembly context:
    - no x:Class, no EventSetter, no custom clr-namespace imports
    - no {StaticResource {x:Type ...}} BasedOn keys — every base style has a string key
    - no WindowChrome: WindowStyle="None" + PowerShell-side DragMove
    - every template name is unique; nothing references anything outside this file

  Named controls (FindName) — must stay in sync with the script:
  barTitle btnMinimize btnClose txtName cmbPreset btnLoadPreset btnSavePreset btnDeletePreset
  lblRotationCount btnClear cmbMap cmbGametype btnAdd lstRotation
  numWar numDom numHp numDm numConf numSd numCtf numGun numBall lblScoreSummary chkHalftime
  lblBotSummary lblBotFill sldBotFill cmbBotNames lblNetSummary txtPort chkConnect lblCfgPath
  dotStatus lblStatus lblStatusSub btnStop btnLaunch
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="S2x Dedicated Server Launcher"
        Width="1160" Height="740" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FF0C0D0F" Foreground="#FFE6E8EA"
        FontFamily="Segoe UI" FontSize="13"
        BorderBrush="#FF2A2F34" BorderThickness="1">

  <Window.Resources>
    <SolidColorBrush x:Key="Accent"    Color="#FFE8A33D"/>
    <SolidColorBrush x:Key="AccentHot" Color="#FFF4BB66"/>
    <SolidColorBrush x:Key="Danger"    Color="#FFC7524A"/>
    <SolidColorBrush x:Key="Ok"        Color="#FF5FBF7A"/>
    <SolidColorBrush x:Key="Ink"       Color="#FFE6E8EA"/>
    <SolidColorBrush x:Key="Muted"     Color="#FF8A9299"/>
    <SolidColorBrush x:Key="Dim"       Color="#FF6F777D"/>
    <SolidColorBrush x:Key="Faint"     Color="#FF5C646B"/>
    <SolidColorBrush x:Key="Label"     Color="#FFA8B0B6"/>
    <SolidColorBrush x:Key="Line"      Color="#FF1C2024"/>
    <SolidColorBrush x:Key="Edge"      Color="#FF262B30"/>
    <SolidColorBrush x:Key="EdgeHot"   Color="#FF3A4147"/>
    <SolidColorBrush x:Key="Field"     Color="#FF16191C"/>
    <SolidColorBrush x:Key="Panel"     Color="#FF0E1012"/>
    <SolidColorBrush x:Key="Bar"       Color="#FF0A0B0D"/>
    <SolidColorBrush x:Key="Row"       Color="#FF121417"/>
    <SolidColorBrush x:Key="Hover"     Color="#FF121417"/>
    <SolidColorBrush x:Key="BtnEdge"   Color="#FF2E343A"/>
    <SolidColorBrush x:Key="IconEdge"  Color="#FF23282D"/>
    <SolidColorBrush x:Key="DangerBg"  Color="#FF1C1211"/>
    <SolidColorBrush x:Key="DangerEdge" Color="#FF4A2A28"/>
    <SolidColorBrush x:Key="TagBg"     Color="#FF1A1710"/>
    <SolidColorBrush x:Key="TagEdge"   Color="#FF3A2F1C"/>
    <SolidColorBrush x:Key="Knob"      Color="#FF0C0D0F"/>
    <SolidColorBrush x:Key="Popup"     Color="#FF16191C"/>
    <SolidColorBrush x:Key="PopupHi"   Color="#FF1F2429"/>
    <SolidColorBrush x:Key="Divider"   Color="#FF24282C"/>
    <SolidColorBrush x:Key="Track"     Color="#FF2C3136"/>
    <SolidColorBrush x:Key="StatusOff" Color="#FF4A5157"/>

    <!-- Text styles -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource Faint}"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Text boxes -->
    <Style x:Key="FlatTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="tbBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="tbBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource FlatTextBox}"/>
    <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource FlatTextBox}">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="Padding" Value="6,5"/>
    </Style>

    <!-- Ghost button -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BtnEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ghostBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ghostBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Quiet text-only button (Clear all) -->
    <Style x:Key="Quiet" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Danger-outline button -->
    <Style x:Key="GhostDanger" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="dangerBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource DangerEdge}" BorderThickness="1"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="dangerBorder" Property="BorderBrush" Value="{StaticResource Danger}"/>
                <Setter TargetName="dangerBorder" Property="Background" Value="{StaticResource DangerBg}"/>
                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Solid accent button -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="{StaticResource Knob}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="40,13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="primaryBorder" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="primaryBorder" Property="Background" Value="{StaticResource AccentHot}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Square icon button -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="iconBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource IconEdge}" BorderThickness="1"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="iconBorder" Property="BorderBrush" Value="{StaticResource EdgeHot}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Title-bar caption buttons -->
    <Style x:Key="CaptionBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="capBorder" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="capBorder" Property="Background" Value="{StaticResource Field}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="closeBorder" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="closeBorder" Property="Background" Value="{StaticResource Danger}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Combo box -->
    <Style x:Key="FlatCombo" TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="comboBorder" Background="{StaticResource Field}"
                            BorderBrush="{StaticResource Edge}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Data="M 0 0 L 8 0 L 4 5 Z" Fill="{StaticResource Dim}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="comboBorder" Property="BorderBrush" Value="{StaticResource EdgeHot}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                IsHitTestVisible="False"/>
              <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                <Border Background="{StaticResource Popup}" BorderBrush="{StaticResource EdgeHot}"
                        BorderThickness="1" MaxHeight="320"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer>
                    <StackPanel IsItemsHost="True"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource FlatCombo}"/>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="itemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource PopupHi}"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Switch-style check box -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="swTrack" Width="34" Height="18" CornerRadius="9"
                      Background="{StaticResource Edge}" VerticalAlignment="Center">
                <Ellipse x:Name="swKnob" Width="14" Height="14" Fill="{StaticResource Knob}"
                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="swTrack" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="swKnob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="swKnob" Property="Margin" Value="0,0,2,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Collapsible settings section -->
    <Style TargetType="Expander">
      <Setter Property="IsExpanded" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
              <StackPanel>
                <ToggleButton Cursor="Hand"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="hdrBorder" Background="Transparent" Padding="20,16">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Path x:Name="hdrCaret" Grid.Column="0" VerticalAlignment="Center"
                                Fill="{StaticResource Dim}" Data="M 0 0 L 7 0 L 3.5 5 Z"/>
                          <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="hdrBorder" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                          <Setter TargetName="hdrCaret" Property="Data" Value="M 0 0 L 5 3.5 L 0 7 Z"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                  <ContentPresenter ContentSource="Header"/>
                </ToggleButton>
                <ContentPresenter x:Name="expBody" Margin="20,0,20,18" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="expBody" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="{StaticResource Edge}"/>
      <Setter Property="IsSnapToTickEnabled" Value="True"/>
      <Setter Property="TickFrequency" Value="1"/>
      <Setter Property="Height" Value="22"/>
    </Style>

    <!-- Rotation row. Items are PSCustomObjects: Num, MapName, GtName, Line -->
    <Style x:Key="RotationItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="rowBorder" Background="{StaticResource Row}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    SnapsToDevicePixels="True">
              <Border x:Name="rowEdge" BorderBrush="{StaticResource BtnEdge}" BorderThickness="2,0,0,0">
                <ContentPresenter/>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="rowBorder" Property="Background" Value="{StaticResource Field}"/>
                <Setter TargetName="rowEdge" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="rowBorder" Property="Background" Value="{StaticResource Field}"/>
                <Setter TargetName="rowBorder" Property="BorderBrush" Value="{StaticResource EdgeHot}"/>
                <Setter TargetName="rowEdge" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="76"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Border x:Name="barTitle" Grid.Row="0" Background="{StaticResource Bar}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Rectangle Width="4" Height="18" Fill="{StaticResource Accent}"/>
          <TextBlock Text="S2x" FontWeight="Bold" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
          <Rectangle Width="1" Height="16" Fill="{StaticResource Divider}" Margin="14,0"/>
          <TextBlock Text="DEDICATED SERVER LAUNCHER" FontSize="11" FontWeight="SemiBold"
                     Foreground="#FF7C858C" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="btnMinimize" Style="{StaticResource CaptionBtn}" Content="&#x2014;"/>
          <Button x:Name="btnClose" Style="{StaticResource CaptionClose}" Content="&#x2715;"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Server name + presets -->
    <Border Grid.Row="1" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
          <TextBlock Text="SERVER NAME" Style="{StaticResource FieldLabel}"/>
          <Border BorderBrush="{StaticResource Accent}" BorderThickness="2,0,0,0">
            <TextBox x:Name="txtName" Text="S2x Dedicated Server" FontSize="14" BorderThickness="0,1,1,1"/>
          </Border>
          <DockPanel Margin="0,6,0,0" LastChildFill="True">
            <StackPanel x:Name="pnlColors" Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
              <TextBlock Text="COLOR" Style="{StaticResource Mono}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <Border Tag="^1" Background="#E0332B" ToolTip="Red  ^1" Width="20" Height="16" Margin="0,0,4,0" CornerRadius="2" Cursor="Hand"/>
              <Border Tag="^2" Background="#34C759" ToolTip="Green  ^2" Width="20" Height="16" Margin="0,0,4,0" CornerRadius="2" Cursor="Hand"/>
              <Border Tag="^3" Background="#F5C400" ToolTip="Yellow  ^3" Width="20" Height="16" Margin="0,0,4,0" CornerRadius="2" Cursor="Hand"/>
              <Border Tag="^4" Background="#3C7BFF" ToolTip="Blue  ^4" Width="20" Height="16" Margin="0,0,4,0" CornerRadius="2" Cursor="Hand"/>
              <Border Tag="^5" Background="#2AD4E0" ToolTip="Cyan  ^5" Width="20" Height="16" Margin="0,0,4,0" CornerRadius="2" Cursor="Hand"/>
              <Border Tag="^6" Background="#E040C8" ToolTip="Magenta  ^6" Width="20" Height="16" Margin="0,0,4,0" CornerRadius="2" Cursor="Hand"/>
              <Border Tag="^7" Background="#F2F2F2" ToolTip="White  ^7" Width="20" Height="16" Margin="0,0,4,0" CornerRadius="2" Cursor="Hand"/>
              <Border Tag="^0" Background="#101010" BorderBrush="{StaticResource Edge}" BorderThickness="1" ToolTip="Black  ^0" Width="20" Height="16" Margin="0,0,4,0" CornerRadius="2" Cursor="Hand"/>
            </StackPanel>
            <TextBlock x:Name="txtNamePreview" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink}"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="PRESET" Style="{StaticResource FieldLabel}"/>
          <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="cmbPreset" Width="190" Height="34"/>
            <Button x:Name="btnLoadPreset"   Style="{StaticResource Ghost}"       Content="Load"    Margin="6,0,0,0"/>
            <Button x:Name="btnSavePreset"   Style="{StaticResource Ghost}"       Content="Save as" Margin="6,0,0,0"/>
            <Button x:Name="btnDeletePreset" Style="{StaticResource GhostDanger}" Content="Delete"  Margin="6,0,0,0" Padding="12,8"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="420"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <Grid Margin="20,18,20,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="MAP ROTATION" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
              <TextBlock x:Name="lblRotationCount" Text="0 entries" FontFamily="Consolas" FontSize="12"
                         Foreground="{StaticResource Accent}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="btnClear" Style="{StaticResource Quiet}" Content="Clear all"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>

          <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="210"/>
              <ColumnDefinition Width="92"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cmbMap"      Grid.Column="0" Height="36"/>
            <ComboBox x:Name="cmbGametype" Grid.Column="1" Height="36" Margin="8,0"/>
            <Button   x:Name="btnAdd"      Grid.Column="2" Style="{StaticResource Primary}"
                      Content="ADD" FontSize="12" Padding="0"/>
          </Grid>

          <ListBox x:Name="lstRotation" Grid.Row="2" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource RotationItem}"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="10,11,12,11">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Num}" FontFamily="Consolas" FontSize="12"
                             Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MapName}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="{Binding Line}" FontFamily="Consolas" FontSize="11.5"
                               Foreground="{StaticResource Dim}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="2" Background="{StaticResource TagBg}" BorderBrush="{StaticResource TagEdge}"
                          BorderThickness="1" Padding="9,5" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding GtName}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"/>
                  </Border>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Tag="up"   Style="{StaticResource IconBtn}" Content="&#x25B2;" ToolTip="Move up"/>
                    <Button Tag="down" Style="{StaticResource IconBtn}" Content="&#x25BC;" Margin="4,0" ToolTip="Move down"/>
                    <Button Tag="del"  Style="{StaticResource IconBtn}" Content="&#x2715;" FontSize="11" ToolTip="Remove"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" Background="{StaticResource Panel}" VerticalScrollBarVisibility="Auto">
        <StackPanel>

          <Expander>
            <Expander.Header>
              <Grid>
                <TextBlock Text="SCORE LIMITS" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="lblScoreSummary" Text="defaults" Style="{StaticResource Mono}"
                           HorizontalAlignment="Right"/>
              </Grid>
            </Expander.Header>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" LastChildFill="True">
                  <TextBox x:Name="numWar" Style="{StaticResource NumBox}" Text="75" Width="52" DockPanel.Dock="Right"/>
                  <TextBlock Text="Team Deathmatch" Style="{StaticResource RowLabel}"/>
                </DockPanel>
                <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" LastChildFill="True">
                  <TextBox x:Name="numDom" Style="{StaticResource NumBox}" Text="200" Width="52" DockPanel.Dock="Right"/>
                  <TextBlock Text="Domination" Style="{StaticResource RowLabel}"/>
                </DockPanel>

                <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8" LastChildFill="True">
                  <TextBox x:Name="numHp" Style="{StaticResource NumBox}" Text="250" Width="52" DockPanel.Dock="Right"/>
                  <TextBlock Text="Hardpoint" Style="{StaticResource RowLabel}"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" LastChildFill="True">
                  <TextBox x:Name="numDm" Style="{StaticResource NumBox}" Text="30" Width="52" DockPanel.Dock="Right"/>
                  <TextBlock Text="Free-for-All" Style="{StaticResource RowLabel}"/>
                </DockPanel>

                <DockPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8" LastChildFill="True">
                  <TextBox x:Name="numConf" Style="{StaticResource NumBox}" Text="65" Width="52" DockPanel.Dock="Right"/>
                  <TextBlock Text="Kill Confirmed" Style="{StaticResource RowLabel}"/>
                </DockPanel>
                <DockPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8" LastChildFill="True">
                  <TextBox x:Name="numSd" Style="{StaticResource NumBox}" Text="4" Width="52" DockPanel.Dock="Right"/>
                  <TextBlock Text="Search and Destroy" Style="{StaticResource RowLabel}"/>
                </DockPanel>

                <DockPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,8" LastChildFill="True">
                  <TextBox x:Name="numCtf" Style="{StaticResource NumBox}" Text="3" Width="52" DockPanel.Dock="Right"/>
                  <TextBlock Text="Capture the Flag" Style="{StaticResource RowLabel}"/>
                </DockPanel>
                <DockPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,8" LastChildFill="True">
                  <TextBox x:Name="numGun" Style="{StaticResource NumBox}" Text="18" Width="52" DockPanel.Dock="Right"/>
                  <TextBlock Text="Gun Game" Style="{StaticResource RowLabel}"/>
                </DockPanel>

                <DockPanel Grid.Row="4" Grid.Column="0" LastChildFill="True">
                  <TextBox x:Name="numBall" Style="{StaticResource NumBox}" Text="28" Width="52" DockPanel.Dock="Right"/>
                  <TextBlock Text="Gridiron" Style="{StaticResource RowLabel}"/>
                </DockPanel>
              </Grid>
              <CheckBox x:Name="chkHalftime" IsChecked="True" Margin="0,16,0,0"
                        Content="Single-round Domination (no halftime)"/>
            </StackPanel>
          </Expander>

          <Expander>
            <Expander.Header>
              <Grid>
                <TextBlock Text="BOTS" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="lblBotSummary" Text="17 bots" Style="{StaticResource Mono}"
                           HorizontalAlignment="Right"/>
              </Grid>
            </Expander.Header>
            <StackPanel>
              <DockPanel LastChildFill="True">
                <TextBlock x:Name="lblBotFill" Text="17" DockPanel.Dock="Right" FontFamily="Consolas"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Bot fill" FontSize="12.5" Foreground="{StaticResource Label}"/>
              </DockPanel>
              <Slider x:Name="sldBotFill" Minimum="0" Maximum="18" Value="17" Margin="0,8,0,4"/>
              <DockPanel Margin="0,0,0,16" LastChildFill="True">
                <TextBlock Text="18" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="10.5"
                           Foreground="{StaticResource Faint}"/>
                <TextBlock Text="0" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource Faint}"/>
              </DockPanel>
              <DockPanel LastChildFill="True">
                <ComboBox x:Name="cmbBotNames" Width="150" Height="32" DockPanel.Dock="Right"/>
                <TextBlock Text="Name pool" FontSize="12.5" Foreground="{StaticResource Label}"
                           VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Expander>

          <Expander>
            <Expander.Header>
              <Grid>
                <TextBlock Text="NETWORK" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="lblNetSummary" Text=":27016" Style="{StaticResource Mono}"
                           HorizontalAlignment="Right"/>
              </Grid>
            </Expander.Header>
            <StackPanel>
              <DockPanel Margin="0,0,0,14" LastChildFill="True">
                <TextBox x:Name="txtPort" Style="{StaticResource NumBox}" Text="27016" Width="86" DockPanel.Dock="Right"/>
                <TextBlock Text="Port" FontSize="12.5" Foreground="{StaticResource Label}" VerticalAlignment="Center"/>
              </DockPanel>
              <CheckBox x:Name="chkConnect" Content="Auto-connect after launch"/>
            </StackPanel>
          </Expander>

          <StackPanel Margin="20,18">
            <TextBlock Text="WRITES TO" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="lblCfgPath" Text="server.cfg" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status + launch -->
    <Border Grid.Row="3" Background="{StaticResource Bar}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="20,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="dotStatus" Width="8" Height="8" Fill="{StaticResource StatusOff}"/>
          <StackPanel Margin="14,0,0,0">
            <TextBlock x:Name="lblStatus" Text="Server stopped" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="lblStatusSub" Text="no process" Style="{StaticResource Mono}" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="btnStop" Style="{StaticResource GhostDanger}" Content="STOP"
                  FontWeight="SemiBold" FontSize="12" Padding="26,13"/>
          <Button x:Name="btnLaunch" Style="{StaticResource Primary}" Content="LAUNCH SERVER" Margin="14,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
